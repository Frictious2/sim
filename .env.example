APP_NAME="Salone Interior Missions Platform"
APP_ENV=development
APP_URL=http://localhost:3000
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=salone_interior_missions
DB_USER=root
DB_PASSWORD=your_mysql_password
SESSION_SECRET=change-this-to-a-long-random-secret
TRUST_PROXY=true
SESSION_COOKIE_SECURE=auto
ADMIN_SEED_NAME="SIM Administrator"

<aside class="dashboard-sidebar-shell admin-sidebar-shell">
  <div class="sidebar-brand">
    <span class="brand-mark">SIM</span>
    <div>
      <div class="fw-bold"><%= site.brand %></div>
      <small class="text-muted">Admin Console</small>
    </div>
  </div>
  <div class="sidebar-profile card-soft mt-4">
    <div class="avatar-circle">A</div>
    <div>
      <div class="fw-semibold">Admin User</div>
      <small class="text-muted">Platform Administrator</small>
    </div>
  </div>
  <nav class="sidebar-nav mt-4">
    <% site.adminNav.forEach((item) => { %>
      <a href="<%= item.href %>" class="sidebar-link <%= currentPath === item.href ? 'active' : '' %>"><%= item.label %></a>
    <% }) %>
  </nav>
  <a href="/" class="btn btn-outline-dark rounded-pill mt-4">Back to Website</a>
</aside>

<section class="section-pad donation-cta-section">
  <div class="container">
    <div class="donation-cta d-lg-flex align-items-center justify-content-between gap-4">
      <div>
        <span class="eyebrow"><%= site.cta.title %></span>
        <h2 class="section-title mt-3 text-white"><%= site.cta.text %></h2>
      </div>
      <div class="d-flex flex-wrap gap-3 mt-4 mt-lg-0">
        <a href="<%= site.cta.primary.href %>" class="btn btn-light rounded-pill px-4"><%= site.cta.primary.label %></a>
        <a href="<%= site.cta.secondary.href %>" class="btn btn-outline-light rounded-pill px-4"><%= site.cta.secondary.label %></a>
      </div>
    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="container py-5">
    <div class="row g-4 g-lg-5 align-items-start">
      <div class="col-lg-4">
        <h5 class="text-white mb-3"><%= site.brand %></h5>
        <p class="text-white-50 mb-3">A warm, trustworthy digital home for ministry engagement, sponsorship, storytelling, and community transformation in Sierra Leone.</p>
        <div class="d-flex flex-wrap gap-2">
          <a href="/donate" class="btn btn-sunrise rounded-pill px-4">Donate Now</a>
          <a href="/sponsor" class="btn btn-outline-light rounded-pill px-4">Sponsor a Child</a>
        </div>
      </div>
      <div class="col-sm-6 col-lg-2">
        <h6 class="footer-heading">Ministry</h6>
        <ul class="list-unstyled footer-links">
          <li><a href="/mission">Mission</a></li>
          <li><a href="/mission-fields">Mission Fields</a></li>
          <li><a href="/projects">Projects</a></li>
          <li><a href="/stories">Stories</a></li>
        </ul>
      </div>
      <div class="col-sm-6 col-lg-3">
        <h6 class="footer-heading">Contact</h6>
        <ul class="list-unstyled footer-links footer-contact">
          <li><a href="mailto:<%= site.contactEmail %>"><%= site.contactEmail %></a></li>
          <li><a href="tel:<%= site.contactPhone ? site.contactPhone.replace(/\s+/g, '') : '' %>"><%= site.contactPhone %></a></li>
          <li><span><%= site.officeAddress %></span></li>
          <li><span>Serving interior communities through local partnerships</span></li>
        </ul>
        <div class="social-links d-flex gap-2 mt-3">
          <a href="<%= site.facebookUrl || '#' %>" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
          <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
          <a href="<%= site.youtubeUrl || '#' %>" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
          <a href="<%= site.whatsappNumber ? `https://wa.me/${site.whatsappNumber.replace(/[^\d]/g, '')}` : '#' %>" aria-label="WhatsApp"><i class="bi bi-whatsapp"></i></a>
        </div>
      </div>
      <div class="col-lg-3">
        <h6 class="footer-heading">Stay Encouraged</h6>
        <p class="text-white-50">Receive mission updates, testimonies, and opportunities to pray and participate.</p>
        <form action="/newsletter/subscribe" method="post" class="newsletter-mock d-flex flex-column gap-2">
          <input type="hidden" name="source" value="footer-newsletter">
          <input class="form-control" type="email" name="email" placeholder="Email address" required>
          <button class="btn btn-outline-light rounded-pill px-4 align-self-sm-start" type="submit">Subscribe</button>
        </form>
        <p class="text-white-50 small mt-3 mb-0">We only send ministry updates, testimonies, and prayer opportunities.</p>
      </div>
    </div>
    <div class="footer-bottom d-flex flex-column flex-md-row justify-content-between gap-2 mt-4 pt-4">
      <span class="text-white-50">&copy; 2026 <%= site.brand %></span>
      <span class="text-white-50">Developed by Davisas Media</span>
    </div>
  </div>
</footer>


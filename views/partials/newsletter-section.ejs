<section class="section-pad bg-white">
  <div class="container">
    <div class="newsletter-card">
      <div class="row g-4 align-items-center">
        <div class="col-lg-7">
          <span class="eyebrow text-dark">Newsletter</span>
          <h2 class="section-title text-dark mt-3"><%= newsletter.title %></h2>
          <p class="text-muted mb-0"><%= newsletter.text %></p>
        </div>
        <div class="col-lg-5">
          <div class="newsletter-mock d-flex flex-column flex-sm-row gap-2">
            <input class="form-control" type="email" placeholder="<%= newsletter.placeholder %>">
            <button class="btn btn-sunrise rounded-pill px-4" type="button"><%= newsletter.button %></button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<% if (demoAlert === 'success') { %>
  <div class="container mt-3">
    <div class="alert alert-success rounded-4 border-0 shadow-sm">Sample success alert for the UI phase. Forms are presentational only in this build.</div>
  </div>
<% } else if (demoAlert === 'info') { %>
  <div class="container mt-3">
    <div class="alert alert-warning rounded-4 border-0 shadow-sm">Demo notice: this is a static interface using placeholder content and non-functional forms.</div>
  </div>
<% } %>

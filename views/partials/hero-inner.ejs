<section class="hero hero-inner position-relative overflow-hidden">
  <div class="container py-5">
    <div class="row align-items-center g-4 py-4">
      <div class="col-lg-7">
        <span class="eyebrow"><%= eyebrow %></span>
        <h1 class="display-4 fw-bold mt-3"><%= heading %></h1>
        <p class="lead text-white-50 mt-3 mb-0"><%= description %></p>
      </div>
      <div class="col-lg-5">
        <img src="<%= image %>" alt="<%= heading %>" class="img-fluid rounded-5 hero-image shadow-lg">
      </div>
    </div>
  </div>
</section>

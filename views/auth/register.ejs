<section class="auth-page-shell">
  <div class="container py-5">
    <div class="auth-split-card overflow-hidden">
      <div class="row g-0 align-items-stretch">
        <div class="col-lg-5">
          <div class="auth-brand-panel h-100">
            <span class="eyebrow">Join the mission</span>
            <h1 class="display-5 fw-bold mt-3">Create your account and begin your partnership journey.</h1>
            <p class="lead text-white-50 mt-4">Register as a donor, sponsor, volunteer, or ministry partner to stay connected with the work of Salone Interior Missions in a more personal and organized way.</p>
            <div class="auth-brand-points mt-4">
              <div class="auth-brand-point">Track giving and sponsorship activity</div>
              <div class="auth-brand-point">Receive mission-focused updates</div>
              <div class="auth-brand-point">Prepare for future volunteer and partner tools</div>
            </div>
          </div>
        </div>
        <div class="col-lg-7">
          <div class="auth-form-panel">
            <div class="auth-form-wrap mx-auto">
              <div class="small text-uppercase text-muted fw-semibold">Register</div>
              <h2 class="section-title text-dark mt-3">Create your account</h2>
              <p class="text-muted">Create your account to begin a donor, sponsor, volunteer, or partner journey with SIM.</p>

              <div class="d-grid gap-2 mt-4">
                <button type="button" class="btn btn-outline-dark rounded-pill social-auth-btn"><i class="bi bi-google me-2"></i>Continue with Google</button>
                <button type="button" class="btn btn-outline-dark rounded-pill social-auth-btn"><i class="bi bi-facebook me-2"></i>Continue with Facebook</button>
              </div>

              <div class="auth-divider my-4"><span>or register with email</span></div>

              <form class="row g-3" action="/register" method="post" novalidate>
                <div class="col-md-6">
                  <label class="form-label fw-semibold">Full name</label>
                  <input class="form-control" name="name" placeholder="Your full name" value="<%= formData && formData.name ? formData.name : '' %>" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-semibold">Phone</label>
                  <input class="form-control" name="phone" placeholder="Phone number" value="<%= formData && formData.phone ? formData.phone : '' %>">
                </div>
                <div class="col-12">
                  <label class="form-label fw-semibold">Email address</label>
                  <input class="form-control" type="email" name="email" placeholder="you@example.com" value="<%= formData && formData.email ? formData.email : '' %>" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-semibold">Password</label>
                  <input class="form-control" type="password" name="password" placeholder="Create a password" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-semibold">Confirm password</label>
                  <input class="form-control" type="password" name="confirmPassword" placeholder="Confirm password" required>
                </div>
                <div class="col-12 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                  <div class="form-check m-0">
                    <input class="form-check-input" type="checkbox" id="registerRemember">
                    <label class="form-check-label" for="registerRemember">Remember me on this device</label>
                  </div>
                  <a href="#" class="auth-link">Forgot password?</a>
                </div>
                <div class="col-12">
                  <button type="submit" class="btn btn-sunrise rounded-pill w-100 py-3">Create Account</button>
                </div>
              </form>

              <p class="text-muted mt-4 mb-0">Already have an account? <a href="/login" class="auth-link fw-semibold">Log in here</a></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="dashboard-section">
  <div class="row g-4">
    <div class="col-xl-7">
      <div class="content-card">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
          <div>
            <h2 class="h4 mb-1">Donation details</h2>
            <p class="text-muted mb-0">Review your donation submission, its current status, and any receipt or proof details.</p>
          </div>
          <a href="/dashboard/donations" class="btn btn-outline-dark rounded-pill btn-sm">Back to donations</a>
        </div>

        <div class="admin-detail-stack">
          <div class="admin-detail-card"><span>Amount</span><strong><%= donation.amountDisplay %></strong></div>
          <div class="admin-detail-card"><span>Designation</span><strong><%= donation.designationLabel %></strong></div>
          <div class="admin-detail-card"><span>Donation type</span><strong><%= donation.donationTypeLabel %></strong></div>
          <div class="admin-detail-card"><span>Payment method</span><strong><%= donation.paymentMethodLabel %></strong></div>
          <div class="admin-detail-card"><span>Status</span><strong><span class="badge <%= donation.statusMeta.badgeClass %>"><%= donation.statusLabel %></span></strong></div>
          <div class="admin-detail-card"><span>Submitted</span><strong><%= donation.createdDisplay %></strong></div>
          <div class="admin-detail-card"><span>Reference</span><strong><%= donation.referenceLabel %></strong></div>
          <% if (donation.verifiedDisplay) { %><div class="admin-detail-card"><span>Verified</span><strong><%= donation.verifiedDisplay %></strong></div><% } %>
        </div>

        <% if (donation.message) { %>
          <div class="content-card mt-4">
            <h3 class="h5 mb-3">Your note</h3>
            <p class="text-muted mb-0"><%= donation.message %></p>
          </div>
        <% } %>

        <div class="content-card mt-4">
          <h3 class="h5 mb-3">Status timeline</h3>
          <% if (timeline && timeline.length) { %>
            <div class="timeline-list">
              <% timeline.forEach((item) => { %>
                <div class="timeline-item">
                  <strong><%= item.newStatusLabel %></strong>
                  <div class="small text-muted"><%= item.createdDisplay %></div>
                  <% if (item.note) { %><div class="text-muted mt-1"><%= item.note %></div><% } %>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p class="text-muted mb-0">No status history is available for this donation yet.</p>
          <% } %>
        </div>
      </div>
    </div>

    <div class="col-xl-5">
      <div class="dashboard-stack d-grid gap-4">
        <div class="content-card bg-sand">
          <h3 class="h5 mb-3">Next steps</h3>
          <p class="text-muted mb-0"><%= donation.nextStep %></p>
        </div>

        <div class="content-card">
          <h3 class="h5 mb-3">Receipt and proof</h3>
          <% if (donation.receipt_number && donation.status === 'verified') { %>
            <div class="admin-detail-card mb-3"><span>Receipt number</span><strong><%= donation.receipt_number %></strong></div>
            <a href="/donations/<%= donation.id %>/receipt" class="btn btn-outline-dark rounded-pill btn-sm">Open Receipt</a>
          <% } else { %>
            <p class="text-muted mb-3">A receipt becomes available after the donation is verified by the SIM team.</p>
          <% } %>

          <% if (donation.proof_file_url) { %>
            <div class="mt-3">
              <a href="<%= donation.proof_file_url %>" target="_blank" rel="noopener" class="btn btn-outline-dark rounded-pill btn-sm">Open Submitted Proof</a>
            </div>
          <% } %>

          <% if (donation.rejection_reason) { %>
            <div class="alert alert-warning rounded-4 mt-3 mb-0">
              <strong>Review note:</strong> <%= donation.rejection_reason %>
            </div>
          <% } %>
        </div>

        <div class="content-card">
          <h3 class="h5 mb-3">Take another step</h3>
          <div class="d-grid gap-2">
            <a href="/donate" class="btn btn-sunrise rounded-pill">Donate Again</a>
            <a href="/sponsor" class="btn btn-outline-dark rounded-pill">Explore Sponsorship</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

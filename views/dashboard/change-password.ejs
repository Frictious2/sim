<section class="dashboard-section">
  <div class="row g-4 justify-content-center">
    <div class="col-xl-7">
      <div class="content-card h-100">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
          <div>
            <h2 class="h4 mb-1">Change password</h2>
            <p class="text-muted mb-0">Update your password while keeping your dashboard account secure.</p>
          </div>
          <a href="/dashboard/profile" class="btn btn-outline-dark rounded-pill btn-sm">Back to profile</a>
        </div>

        <form method="post" action="/dashboard/change-password" class="row g-4">
          <div class="col-12">
            <label class="form-label fw-semibold">Current password <span class="text-danger">*</span></label>
            <input class="form-control" type="password" name="currentPassword" required>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">New password <span class="text-danger">*</span></label>
            <input class="form-control" type="password" name="newPassword" required>
            <div class="form-text">Use at least 8 characters.</div>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Confirm new password <span class="text-danger">*</span></label>
            <input class="form-control" type="password" name="confirmPassword" required>
          </div>
          <div class="col-12 d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-sunrise rounded-pill px-4">Update Password</button>
            <a href="/dashboard/profile" class="btn btn-outline-dark rounded-pill px-4">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/page-banner', { eyebrow: 'Blog', heading: 'Mission reflections, updates, and ministry insight.', description: 'A clean card-based blog layout for stories, strategic reflections, and field updates.' }) %>
<section class="section-pad pt-0 bg-cream">
  <div class="container">
    <div class="row g-4">
      <div class="col-lg-8">
        <div class="row g-4">
          <% content.blogPosts.forEach((post) => { %>
            <div class="col-md-6">
              <article class="story-card h-100">
                <span class="badge text-bg-warning-subtle text-dark rounded-pill"><%= post.category %></span>
                <h3 class="h4 mt-3"><%= post.title %></h3>
                <p class="text-muted"><%= post.excerpt %></p>
                <small class="text-muted"><%= post.author %> • <%= post.date %></small>
              </article>
            </div>
          <% }) %>
        </div>
      </div>
      <div class="col-lg-4">
        <%- include('../partials/page-sidebar', { title: 'Browse Pages', links: site.publicNav.slice(0, 6) }) %>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/page-banner', { eyebrow: 'Donate', heading: 'Give with warmth, clarity, and confidence.', description: 'The donation UI emphasizes trust and stewardship while staying intentionally static for this phase.' }) %>
<section class="section-pad pt-0 bg-cream">
  <div class="container">
    <div class="row g-4 mb-4">
      <% content.donationLevels.forEach((level) => { %>
        <div class="col-md-6 col-lg-3">
          <div class="content-card text-center h-100">
            <div class="display-6 fw-bold"><%= level.amount %></div>
            <p class="text-muted mb-0"><%= level.label %></p>
          </div>
        </div>
      <% }) %>
    </div>
    <div class="content-card bg-white">
      <div class="row g-4 align-items-center">
        <div class="col-lg-5">
          <h3 class="h4">Donation form</h3>
          <p class="text-muted mb-0">Prepared for future payment integration while already delivering a credible donor-facing experience.</p>
        </div>
        <div class="col-lg-7">
          <form class="row g-3">
            <div class="col-md-6"><input class="form-control" placeholder="Donor name"></div>
            <div class="col-md-6"><input class="form-control" type="email" placeholder="Donor email"></div>
            <div class="col-md-4"><input class="form-control" placeholder="Amount"></div>
            <div class="col-md-4"><select class="form-select"><option>One-time</option><option>Monthly</option><option>Quarterly</option></select></div>
            <div class="col-md-4"><input class="form-control" placeholder="Campaign"></div>
            <div class="col-12"><button type="button" class="btn btn-sunrise rounded-pill px-4">Give to the Mission</button></div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
<%- include('../partials/newsletter-section', { newsletter: content.newsletter }) %>

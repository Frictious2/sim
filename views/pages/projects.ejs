<%- include('../partials/page-banner', { eyebrow: 'Projects and programs', heading: 'Visible opportunities to strengthen communities.', description: 'Browse mission initiatives with clear summaries, imagery, and ministry progress highlights.' }) %>
<section class="section-pad pt-0 bg-cream">
  <div class="container">
    <div class="row g-4">
      <% content.featuredProjects.forEach((project) => { %>
        <div class="col-lg-4">
          <article class="project-card h-100">
            <img src="<%= project.image %>" alt="<%= project.title %>" class="img-fluid rounded-4 project-image mb-4">
            <span class="badge text-bg-light rounded-pill"><%= project.location %></span>
            <h3 class="h4 mt-3"><%= project.title %></h3>
            <p class="text-muted"><%= project.summary %></p>
            <div class="mini-stat-row mt-3"><span>Program focus</span><strong><%= project.raised %></strong></div>
            <div class="mini-stat-row"><span>Current status</span><strong><%= project.goal %></strong></div>
            <div class="mini-stat-row"><span>Progress note</span><strong><%= project.progress %></strong></div>
          </article>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<%- include('../partials/call-to-action') %>

<%- include('../partials/hero-home') %>

<section class="section-pad bg-white home-intro-section">
  <div class="container">
    <div class="row g-4 align-items-center">
      <div class="col-lg-5">
        <span class="eyebrow text-dark">Welcome to Salone Interior Missions</span>
        <h2 class="section-title text-dark mt-3">We exist to carry the Gospel inward, strengthen local churches, and help communities flourish with dignity.</h2>
      </div>
      <div class="col-lg-7">
        <div class="content-card intro-card h-100">
          <p class="lead text-muted mb-3">Salone Interior Missions walks alongside pastors, evangelists, children, families, and underserved communities across Sierra Leone with a ministry model shaped by prayer, presence, and long-term partnership.</p>
          <p class="text-muted mb-0">Through evangelism, discipleship, church planting, sponsorship, leadership development, and practical community support, we seek to see lives transformed by Christ and communities strengthened from within.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section-pad bg-cream mission-pillars-section">
  <div class="container">
    <div class="section-intro text-center mb-5">
      <span class="eyebrow text-dark">Mission pillars</span>
      <h2 class="section-title text-dark mt-3">Four ministry commitments guiding every field initiative.</h2>
      <p class="text-muted col-lg-8 mx-auto">These pillars help visitors quickly understand the heart of the mission while inviting them to explore deeper pathways of engagement.</p>
    </div>
    <div class="row g-4">
      <div class="col-md-6 col-xl-3">
        <div class="ministry-card h-100">
          <div class="icon-badge"><i class="bi bi-broadcast"></i></div>
          <h3 class="h5 mt-4">Evangelism</h3>
          <p class="text-muted">Sharing the hope of Christ through village outreaches, public witness, and personal discipleship conversations.</p>
          <a href="/mission" class="btn btn-link px-0 text-decoration-none stretched-link-link">Learn more <i class="bi bi-arrow-right ms-1"></i></a>
        </div>
      </div>
      <div class="col-md-6 col-xl-3">
        <div class="ministry-card h-100">
          <div class="icon-badge"><i class="bi bi-journal-richtext"></i></div>
          <h3 class="h5 mt-4">Discipleship</h3>
          <p class="text-muted">Equipping believers, mentoring young leaders, and grounding churches in Scripture and spiritual formation.</p>
          <a href="/mission-fields" class="btn btn-link px-0 text-decoration-none">Learn more <i class="bi bi-arrow-right ms-1"></i></a>
        </div>
      </div>
      <div class="col-md-6 col-xl-3">
        <div class="ministry-card h-100">
          <div class="icon-badge"><i class="bi bi-building"></i></div>
          <h3 class="h5 mt-4">Church Planting</h3>
          <p class="text-muted">Encouraging new fellowships and strengthening emerging congregations in places with limited ministry presence.</p>
          <a href="/mission" class="btn btn-link px-0 text-decoration-none">Learn more <i class="bi bi-arrow-right ms-1"></i></a>
        </div>
      </div>
      <div class="col-md-6 col-xl-3">
        <div class="ministry-card h-100">
          <div class="icon-badge"><i class="bi bi-heart-pulse"></i></div>
          <h3 class="h5 mt-4">Community Transformation</h3>
          <p class="text-muted">Supporting children, families, women, and local leaders through practical, compassionate, and sustainable initiatives.</p>
          <a href="/projects" class="btn btn-link px-0 text-decoration-none">Learn more <i class="bi bi-arrow-right ms-1"></i></a>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/mission-stats', { items: content.impactStats }) %>

<section class="section-pad bg-white featured-programs-section">
  <div class="container">
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
      <div>
        <span class="eyebrow text-dark">Featured programs</span>
        <h2 class="section-title text-dark mt-3">Practical ways supporters can help advance the mission.</h2>
      </div>
      <a href="/projects" class="btn btn-outline-dark rounded-pill px-4">See All Programs</a>
    </div>
    <div class="row g-4">
      <div class="col-md-6 col-xl-3">
        <article class="program-card h-100">
          <img src="https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&w=1200&q=80" alt="Sponsor a child" class="img-fluid rounded-4 program-image mb-4">
          <h3 class="h5">Sponsor a Child</h3>
          <p class="text-muted">Help a child access education, care, encouragement, and consistent prayer support through relationship-centered sponsorship.</p>
          <a href="/sponsor" class="btn btn-outline-dark rounded-pill btn-sm">Explore Sponsorship</a>
        </article>
      </div>
      <div class="col-md-6 col-xl-3">
        <article class="program-card h-100">
          <img src="https://images.unsplash.com/photo-1511632765486-a01980e01a18?auto=format&fit=crop&w=1200&q=80" alt="Mission outreach" class="img-fluid rounded-4 program-image mb-4">
          <h3 class="h5">Mission Outreach</h3>
          <p class="text-muted">Resource evangelistic visits, prayer gatherings, discipleship follow-up, and Gospel witness in hard-to-reach communities.</p>
          <a href="/projects" class="btn btn-outline-dark rounded-pill btn-sm">Support Outreach</a>
        </article>
      </div>
      <div class="col-md-6 col-xl-3">
        <article class="program-card h-100">
          <img src="https://images.unsplash.com/photo-1517048676732-d65bc937f952?auto=format&fit=crop&w=1200&q=80" alt="Leadership training" class="img-fluid rounded-4 program-image mb-4">
          <h3 class="h5">Leadership Training</h3>
          <p class="text-muted">Invest in pastors, ministry workers, and emerging leaders through biblical formation and practical ministry support.</p>
          <a href="/mission-fields" class="btn btn-outline-dark rounded-pill btn-sm">See Training Focus</a>
        </article>
      </div>
      <div class="col-md-6 col-xl-3">
        <article class="program-card h-100">
          <img src="https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?auto=format&fit=crop&w=1200&q=80" alt="Community support" class="img-fluid rounded-4 program-image mb-4">
          <h3 class="h5">Community Support</h3>
          <p class="text-muted">Stand with families through literacy support, women empowerment, mercy outreach, and resilient local care initiatives.</p>
          <a href="/projects" class="btn btn-outline-dark rounded-pill btn-sm">View Community Work</a>
        </article>
      </div>
    </div>
  </div>
</section>

<section class="section-pad bg-cream why-partner-section">
  <div class="container">
    <div class="row g-5 align-items-center">
      <div class="col-lg-6 order-2 order-lg-1">
        <div class="content-card h-100">
          <span class="eyebrow text-dark">Why partner with us</span>
          <h2 class="section-title text-dark mt-3">A ministry approach shaped by faithfulness, transparency, and local trust.</h2>
          <p class="text-muted">We believe people give and pray with confidence when they can see the mission clearly. That is why we emphasize honest communication, accountable stewardship, and long-term relationships with communities and local leaders.</p>
          <div class="row g-3 mt-2">
            <div class="col-sm-6"><div class="partner-point"><strong>Transparency</strong><span>Clear updates, visible priorities, and stewardship-minded communication.</span></div></div>
            <div class="col-sm-6"><div class="partner-point"><strong>Faith-driven mission</strong><span>Every initiative is anchored in Gospel witness and prayerful dependence on God.</span></div></div>
            <div class="col-sm-6"><div class="partner-point"><strong>Local presence</strong><span>We serve alongside community leaders who understand the context and needs firsthand.</span></div></div>
            <div class="col-sm-6"><div class="partner-point"><strong>Long-term transformation</strong><span>We pursue enduring change rather than short-lived visibility or one-time activity.</span></div></div>
          </div>
        </div>
      </div>
      <div class="col-lg-6 order-1 order-lg-2">
        <div class="image-stack-card">
          <img src="https://images.unsplash.com/photo-1542810634-71277d95dcbb?auto=format&fit=crop&w=1200&q=80" alt="Community presence and ministry partnership" class="img-fluid rounded-5 shadow-lg why-partner-image">
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section-pad bg-white stories-preview-section">
  <div class="container">
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
      <div>
        <span class="eyebrow text-dark">Stories and testimonies</span>
        <h2 class="section-title text-dark mt-3">Glimpses of lives being strengthened through faithful ministry.</h2>
      </div>
      <a href="/stories" class="btn btn-outline-dark rounded-pill px-4">Read More Stories</a>
    </div>
    <div class="row g-4">
      <% content.stories.forEach((story, index) => { %>
        <div class="col-lg-4">
          <article class="story-preview-card h-100">
            <img src="<%= content.gallery[index] ? content.gallery[index].image : 'https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=1200&q=80' %>" alt="<%= story.title %>" class="img-fluid rounded-4 story-preview-image mb-4">
            <span class="badge text-bg-light rounded-pill"><%= story.tag %></span>
            <h3 class="h5 mt-3"><%= story.title %></h3>
            <p class="text-muted">"<%= story.excerpt %>"</p>
            <a href="/stories" class="btn btn-outline-dark rounded-pill btn-sm">Read More</a>
          </article>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="section-pad bg-cream latest-updates-section">
  <div class="container">
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
      <div>
        <span class="eyebrow text-dark">Latest updates</span>
        <h2 class="section-title text-dark mt-3">Recent news, field reflections, and ministry insight.</h2>
      </div>
      <a href="/blog" class="btn btn-outline-dark rounded-pill px-4">Visit the Blog</a>
    </div>
    <div class="row g-4">
      <% content.blogPosts.forEach((post) => { %>
        <div class="col-md-6 col-xl-4">
          <article class="story-card h-100">
            <span class="badge text-bg-warning-subtle text-dark rounded-pill"><%= post.category %></span>
            <h3 class="h5 mt-3"><%= post.title %></h3>
            <p class="text-muted"><%= post.excerpt %></p>
            <small class="text-muted d-block mb-3"><%= post.author %> • <%= post.date %></small>
            <a href="/blog" class="btn btn-outline-dark rounded-pill btn-sm">Read Update</a>
          </article>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<%- include('../partials/call-to-action') %>
<%- include('../partials/newsletter-section', { newsletter: content.newsletter }) %>

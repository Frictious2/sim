<section class="premium-hero-section">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <span class="eyebrow">Faith-driven mission engagement</span>
        <h1 class="premium-hero-title mt-3"><%= content.homeHero.title %></h1>
        <p class="premium-hero-copy mt-4"><%= content.homeHero.text %></p>
        <div class="d-flex flex-wrap gap-3 mt-4">
          <a href="<%= content.homeHero.primary.href %>" class="btn btn-sunrise btn-lg rounded-pill px-4"><%= content.homeHero.primary.label %></a>
          <a href="<%= content.homeHero.secondary.href %>" class="btn btn-outline-dark btn-lg rounded-pill px-4"><%= content.homeHero.secondary.label %></a>
        </div>
        <p class="premium-hero-trust mt-3 mb-0"><i class="bi bi-shield-check me-2"></i><%= content.homeHero.trust %></p>
      </div>
      <div class="col-lg-6">
        <div class="hero-visual-wrap">
          <div class="hero-image-card hero-image-main">
            <img src="<%= content.homeHeroImage || 'https://images.unsplash.com/photo-1511632765486-a01980e01a18?auto=format&fit=crop&w=1200&q=80' %>" alt="Mission outreach in Sierra Leone" class="img-fluid">
          </div>
          <div class="hero-image-card hero-image-secondary">
            <img src="<%= content.homeHeroSecondaryImage || 'https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&w=900&q=80' %>" alt="Children supported through ministry" class="img-fluid">
          </div>
          <div class="floating-stat floating-stat-a">
            <strong><%= content.homeHeroStats[0].value %></strong>
            <span><%= content.homeHeroStats[0].label %></span>
          </div>
          <div class="floating-stat floating-stat-b">
            <strong><%= content.homeHeroStats[1].value %></strong>
            <span><%= content.homeHeroStats[1].label %></span>
          </div>
          <div class="floating-stat floating-stat-c">
            <strong><%= content.homeHeroStats[2].value %></strong>
            <span><%= content.homeHeroStats[2].label %></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section-pad home-mission-intro bg-white">
  <div class="container">
    <div class="row g-4 align-items-stretch">
      <div class="col-lg-6">
        <div class="content-card intro-story-card h-100">
          <span class="eyebrow text-dark"><%= content.homeIntro && content.homeIntro.title ? content.homeIntro.title : 'Who we are' %></span>
          <h2 class="section-title text-dark mt-3"><%= content.homeIntro ? content.homeIntro.subtitle : 'A ministry walking with interior communities through Gospel witness and practical care.' %></h2>
          <div class="cms-rich-copy text-muted"><%- content.homeIntro ? content.homeIntro.content : 'Salone Interior Missions exists to serve churches, families, children, and underserved communities in Sierra Leone with evangelism, discipleship, church planting, and compassionate community support.' %></div>
          <p class="text-muted mb-4">We believe mission is strongest when it is local, relational, accountable, and rooted in long-term transformation rather than short-lived visibility.</p>
          <a href="<%= content.homeIntro && content.homeIntro.buttonUrl ? content.homeIntro.buttonUrl : '/about' %>" class="btn btn-outline-dark rounded-pill px-4"><%= content.homeIntro && content.homeIntro.buttonLabel ? content.homeIntro.buttonLabel : 'Learn About SIM' %></a>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="content-card mission-statement-highlight h-100">
          <span class="eyebrow text-dark">Mission statement</span>
          <blockquote class="mission-highlight-quote mt-3 mb-0">To proclaim Christ, disciple believers, strengthen churches, and serve interior communities with compassionate, faithful presence that leads to lasting transformation.</blockquote>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section-pad bg-cream premium-pillars-section">
  <div class="container">
    <div class="section-intro text-center mb-5">
      <span class="eyebrow text-dark">Mission pillars</span>
      <h2 class="section-title text-dark mt-3">Four commitments guiding the work on the ground.</h2>
      <p class="text-muted col-lg-8 mx-auto">Each ministry area helps supporters understand how prayer, sponsorship, giving, and partnership contribute to real Gospel-centered change.</p>
    </div>
    <div class="row g-4">
      <div class="col-md-6 col-xl-3">
        <article class="pillar-card h-100">
          <div class="pillar-icon"><i class="bi bi-broadcast"></i></div>
          <h3 class="h5 mt-4">Evangelism</h3>
          <p class="text-muted">Taking the Gospel into villages and underserved areas through outreach, prayer, and relational witness.</p>
          <a href="/mission" class="pillar-link">Learn More <i class="bi bi-arrow-right-short"></i></a>
        </article>
      </div>
      <div class="col-md-6 col-xl-3">
        <article class="pillar-card h-100">
          <div class="pillar-icon"><i class="bi bi-journal-richtext"></i></div>
          <h3 class="h5 mt-4">Discipleship</h3>
          <p class="text-muted">Helping believers grow through Scripture, mentoring, leadership encouragement, and faithful follow-up.</p>
          <a href="/mission" class="pillar-link">Learn More <i class="bi bi-arrow-right-short"></i></a>
        </article>
      </div>
      <div class="col-md-6 col-xl-3">
        <article class="pillar-card h-100">
          <div class="pillar-icon"><i class="bi bi-building"></i></div>
          <h3 class="h5 mt-4">Church Planting</h3>
          <p class="text-muted">Strengthening local fellowships and encouraging new ministry presence in overlooked communities.</p>
          <a href="/mission-fields" class="pillar-link">Learn More <i class="bi bi-arrow-right-short"></i></a>
        </article>
      </div>
      <div class="col-md-6 col-xl-3">
        <article class="pillar-card h-100">
          <div class="pillar-icon"><i class="bi bi-heart-pulse"></i></div>
          <h3 class="h5 mt-4">Community Transformation</h3>
          <p class="text-muted">Serving families through child support, literacy, women empowerment, mercy outreach, and local care.</p>
          <a href="/projects" class="pillar-link">Learn More <i class="bi bi-arrow-right-short"></i></a>
        </article>
      </div>
    </div>
  </div>
</section>

<section class="impact-band-section">
  <div class="container">
    <div class="impact-band-wrap">
      <div class="row g-4 text-center">
        <% content.homeImpactBand.forEach((item) => { %>
          <div class="col-6 col-lg-3">
            <div class="impact-band-item">
              <strong><%= item.value %></strong>
              <span><%= item.label %></span>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</section>

<section class="section-pad bg-white featured-programs-premium">
  <div class="container">
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
      <div>
        <span class="eyebrow text-dark">Featured programs</span>
        <h2 class="section-title text-dark mt-3">Clear ways to support the mission where it matters most.</h2>
      </div>
      <a href="/projects" class="btn btn-outline-dark rounded-pill px-4">View All Programs</a>
    </div>
    <div class="row g-4">
      <% content.homePrograms.forEach((program, index) => { %>
        <div class="col-md-6 col-xl-3">
          <article class="program-premium-card h-100">
            <div class="program-image-placeholder <%= 'program-shade-' + (index + 1) %>">
              <% if (program.image) { %>
                <img src="<%= program.image %>" alt="<%= program.title %>" class="img-fluid">
              <% } else { %>
                <span><%= program.title %></span>
              <% } %>
            </div>
            <div class="pt-4">
              <span class="badge text-bg-warning-subtle text-dark rounded-pill"><%= program.badge %></span>
              <h3 class="h5 mt-3"><%= program.title %></h3>
              <p class="text-muted"><%= program.description %></p>
              <a href="<%= program.href %>" class="btn btn-outline-dark rounded-pill btn-sm">Learn More</a>
            </div>
          </article>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="section-pad bg-cream why-partner-premium">
  <div class="container">
    <div class="row g-5 align-items-center">
      <div class="col-lg-6 order-2 order-lg-1">
        <span class="eyebrow text-dark">Why partner with SIM</span>
        <h2 class="section-title text-dark mt-3">A ministry partnership model shaped by presence, transparency, and long-term faithfulness.</h2>
        <div class="partner-reasons-grid mt-4">
          <div class="partner-reason-item"><i class="bi bi-geo-alt"></i><span>Local mission presence in interior communities</span></div>
          <div class="partner-reason-item"><i class="bi bi-cross"></i><span>Gospel-centered outreach and discipleship</span></div>
          <div class="partner-reason-item"><i class="bi bi-clipboard-data"></i><span>Transparent support tracking and communication</span></div>
          <div class="partner-reason-item"><i class="bi bi-arrow-repeat"></i><span>Long-term community transformation</span></div>
          <div class="partner-reason-item"><i class="bi bi-people"></i><span>Meaningful pathways for churches and individuals</span></div>
        </div>
      </div>
      <div class="col-lg-6 order-1 order-lg-2">
        <div class="why-partner-image-card">
          <img src="<%= content.homePartnershipCta && content.homePartnershipCta.image ? content.homePartnershipCta.image : 'https://images.unsplash.com/photo-1542810634-71277d95dcbb?auto=format&fit=crop&w=1200&q=80' %>" alt="Local ministry partnership" class="img-fluid rounded-5">
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section-pad bg-white story-preview-premium">
  <div class="container">
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
      <div>
        <span class="eyebrow text-dark">Stories and testimonies</span>
        <h2 class="section-title text-dark mt-3">People, places, and moments that show the mission is real.</h2>
      </div>
      <a href="/stories" class="btn btn-outline-dark rounded-pill px-4">Explore Stories</a>
    </div>
    <div class="row g-4">
      <% content.testimonials.forEach((item, index) => { %>
        <div class="col-lg-4">
          <article class="story-premium-card h-100">
            <img src="<%= item.image || (content.gallery[index] ? content.gallery[index].image : 'https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=1200&q=80') %>" alt="<%= item.name %> story" class="img-fluid rounded-4 mb-4 story-premium-image">
            <p class="story-quote">"<%= item.quote %>"</p>
            <div class="small text-muted mt-3"><strong><%= item.name %></strong> • <%= item.role %></div>
            <a href="/stories" class="btn btn-outline-dark rounded-pill btn-sm mt-3">Read Story</a>
          </article>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="section-pad bg-cream latest-updates-premium">
  <div class="container">
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
      <div>
        <span class="eyebrow text-dark">Latest updates</span>
        <h2 class="section-title text-dark mt-3">Recent ministry news, reflections, and field updates.</h2>
      </div>
      <a href="/blog" class="btn btn-outline-dark rounded-pill px-4">Visit the Blog</a>
    </div>
    <div class="row g-4">
      <% content.blogPosts.forEach((post) => { %>
        <div class="col-md-6 col-xl-4">
          <article class="update-premium-card h-100">
            <span class="badge text-bg-warning-subtle text-dark rounded-pill"><%= post.category %></span>
            <h3 class="h5 mt-3"><%= post.title %></h3>
            <div class="small text-muted mb-3"><%= post.date %></div>
            <p class="text-muted"><%= post.excerpt %></p>
            <a href="/blog/<%= post.slug || 'featured-post' %>" class="btn btn-outline-dark rounded-pill btn-sm">Read More</a>
          </article>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="section-pad prayer-partnership-cta">
  <div class="container">
    <div class="partnership-cta-wrap">
      <span class="eyebrow">Pray, give, and partner</span>
      <h2 class="section-title text-white mt-3"><%= content.homePartnershipCta ? content.homePartnershipCta.title : 'Join the mission through prayer, generosity, volunteering, and long-term partnership.' %></h2>
      <% if (content.homePartnershipCta && (content.homePartnershipCta.subtitle || content.homePartnershipCta.content)) { %>
        <div class="cms-rich-copy text-white mt-3 col-lg-8">
          <p class="mb-2"><%= content.homePartnershipCta.subtitle || '' %></p>
          <%- content.homePartnershipCta.content || '' %>
        </div>
      <% } %>
      <div class="d-flex flex-wrap gap-3 mt-4">
        <a href="<%= content.homePartnershipCta && content.homePartnershipCta.buttonUrl ? content.homePartnershipCta.buttonUrl : '/get-involved' %>" class="btn btn-light rounded-pill px-4"><%= content.homePartnershipCta && content.homePartnershipCta.buttonLabel ? content.homePartnershipCta.buttonLabel : 'Become a Prayer Partner' %></a>
        <a href="/get-involved" class="btn btn-outline-light rounded-pill px-4">Get Involved</a>
      </div>
    </div>
  </div>
</section>

<section class="section-pad bg-white premium-newsletter-section">
  <div class="container">
    <div class="newsletter-premium-card">
      <div class="row g-4 align-items-center">
        <div class="col-lg-6">
          <span class="eyebrow text-dark">Stay connected</span>
          <h2 class="section-title text-dark mt-3"><%= content.newsletter.title %></h2>
          <p class="text-muted mb-0"><%= content.newsletter.text %></p>
        </div>
        <div class="col-lg-6">
          <form action="/newsletter/subscribe" method="post" class="newsletter-premium-form">
            <input type="hidden" name="source" value="home-page">
            <input type="email" class="form-control" name="email" placeholder="<%= content.newsletter.placeholder %>" required>
            <button type="submit" class="btn btn-sunrise rounded-pill px-4"><%= content.newsletter.button %></button>
          </form>
          <p class="newsletter-privacy mt-3 mb-0"><%= content.newsletter.privacyText || 'We will only send ministry updates, stories, and prayer opportunities. No spam.' %></p>
        </div>
      </div>
    </div>
  </div>
</section>

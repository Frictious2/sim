<%- include('../partials/page-header', { eyebrow: 'Sponsorship', heading: 'Sponsor a child, program, or mission initiative.', description: 'This UI phase presents the sponsorship pathways with warm, ministry-centered language and presentational forms.' }) %>
<section class="section-pad pt-0 bg-white"><div class="container"><div class="row g-4 mb-4"><% content.sponsorshipOptions.forEach((item) => { %><div class="col-lg-4"><div class="content-card h-100"><span class="badge text-bg-warning-subtle text-dark rounded-pill"><%= item.amount %></span><h3 class="h4 mt-3"><%= item.title %></h3><p class="text-muted mb-0"><%= item.text %></p></div></div><% }) %></div><div class="content-card bg-sand"><div class="row g-4 align-items-center"><div class="col-lg-5"><h3 class="h4">Sponsorship interest form</h3><p class="text-muted mb-0">Designed for future integration while already reflecting the emotional tone of a thoughtful sponsor journey.</p></div><div class="col-lg-7"><form class="row g-3"><div class="col-md-6"><input class="form-control" placeholder="Sponsor name"></div><div class="col-md-6"><input class="form-control" type="email" placeholder="Email address"></div><div class="col-md-6"><select class="form-select"><option>Choose sponsorship type</option><option>Child Sponsorship</option><option>Program Sponsorship</option><option>Project Sponsorship</option></select></div><div class="col-md-6"><input class="form-control" placeholder="Preferred focus"></div><div class="col-12"><button type="button" class="btn btn-sunrise rounded-pill px-4">Start Sponsorship</button></div></form></div></div></div></div></section>

<%- include('../partials/page-header', { eyebrow: 'Gallery', heading: 'A visual window into mission life and community presence.', description: 'Placeholder imagery helps shape a trustworthy, humanitarian, and community-centered visual tone.' }) %>
<section class="section-pad pt-0 bg-cream"><div class="container"><div class="row g-4"><% content.gallery.forEach((item) => { %><div class="col-md-6 col-lg-4"><div class="gallery-card h-100"><img src="<%= item.image %>" alt="<%= item.title %>" class="img-fluid rounded-4 gallery-image"><div class="pt-3 fw-semibold"><%= item.title %></div></div></div><% }) %></div></div></section>

<%- include('../partials/page-banner', {
  eyebrow: 'Mission and Vision',
  heading: pageRecord && pageRecord.title ? pageRecord.title : 'A Gospel-rooted mission for spiritual renewal, strong churches, and transformed communities.',
  description: pageRecord && pageRecord.subtitle ? pageRecord.subtitle : 'This page expresses the theological and organizational convictions guiding Salone Interior Missions as it serves interior communities across Sierra Leone.'
}) %>

<%- include('../partials/managed-page-body') %>
<%- include('../partials/managed-page-sections') %>

<% if (!(pageRecord && pageRecord.sections && pageRecord.sections.length)) { %>
<section class="section-pad pt-0 bg-white mission-statement-section">
  <div class="container">
    <div class="row g-5 align-items-center">
      <div class="col-lg-7">
        <div class="content-card h-100 highlight-card">
          <span class="eyebrow text-dark">Our mission</span>
          <h2 class="section-title text-dark mt-3">To proclaim the Gospel of Jesus Christ, disciple believers, strengthen local churches, and serve interior communities with compassionate, faithful presence.</h2>
          <p class="text-muted mb-0">We exist to help people encounter Christ, grow in biblical faith, and experience practical expressions of Gods love through evangelism, discipleship, leadership formation, and community-centered ministry.</p>
        </div>
      </div>
      <div class="col-lg-5">
        <div class="quote-panel h-100">
          <div class="quote-mark"></div>
          <p class="quote-text">Go therefore and make disciples of all nations... teaching them to observe all that I have commanded you.</p>
          <div class="quote-ref">Matthew 28:19-20</div>
        </div>
      </div>
    </div>
  </div>
</section>


<% if (pageRecord && pageRecord.body) { %>
  <section class="section-pad pt-0 bg-white">
    <div class="container">
      <div class="content-card">
        <div class="cms-rich-copy text-muted"><%- pageRecord.body %></div>
      </div>
    </div>
  </section>
<% } %>

<section class="section-pad bg-cream vision-statement-section">
  <div class="container">
    <div class="row g-5 align-items-center">
      <div class="col-lg-5 order-2 order-lg-1">
        <div class="quote-panel alt-quote-panel h-100">
          <div class="quote-mark"></div>
          <p class="quote-text">Let your light shine before others, so that they may see your good works and give glory to your Father who is in heaven.</p>
          <div class="quote-ref">Matthew 5:16</div>
        </div>
      </div>
      <div class="col-lg-7 order-1 order-lg-2">
        <div class="content-card h-100 alt-highlight-card">
          <span class="eyebrow text-dark">Our vision</span>
          <h2 class="section-title text-dark mt-3">To see interior communities transformed by the love of Christ through thriving churches, equipped leaders, supported children, and resilient families.</h2>
          <p class="text-muted mb-0">We envision communities where the Gospel is deeply present, local believers are spiritually mature, churches are strong and outward-looking, and families encounter hope in both spiritual and practical dimensions of life.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section-pad bg-white scripture-foundation-section">
  <div class="container">
    <div class="section-intro text-center mb-5">
      <span class="eyebrow text-dark">Scripture-inspired foundation</span>
      <h2 class="section-title text-dark mt-3">Biblical convictions shaping the ministrys direction.</h2>
    </div>
    <div class="row g-4">
      <div class="col-lg-4">
        <div class="foundation-card h-100">
          <h3 class="h5">The Great Commission</h3>
          <p class="text-muted">We are sent to make disciples, teach believers, and call communities toward the hope and lordship of Christ.</p>
          <small class="text-muted fw-semibold">Matthew 28:18-20</small>
        </div>
      </div>
      <div class="col-lg-4">
        <div class="foundation-card h-100">
          <h3 class="h5">The Great Commandment</h3>
          <p class="text-muted">Love for God and love for neighbor call us to a ministry that is both spiritually faithful and compassionately present.</p>
          <small class="text-muted fw-semibold">Matthew 22:37-39</small>
        </div>
      </div>
      <div class="col-lg-4">
        <div class="foundation-card h-100">
          <h3 class="h5">The ministry of light</h3>
          <p class="text-muted">We seek to shine the light of Christ through good works, godly character, and visible service in the community.</p>
          <small class="text-muted fw-semibold">Matthew 5:14-16</small>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section-pad bg-cream ministry-objectives-section">
  <div class="container">
    <div class="section-intro text-center mb-5">
      <span class="eyebrow text-dark">Strategic ministry objectives</span>
      <h2 class="section-title text-dark mt-3">Clear ministry priorities for faithful, long-term service.</h2>
      <p class="text-muted col-lg-8 mx-auto">These objectives help translate calling into sustained action across evangelism, discipleship, leadership, and community care.</p>
    </div>
    <div class="row g-4">
      <div class="col-md-6 col-xl-3">
        <div class="objective-card h-100">
          <div class="icon-badge"><i class="bi bi-broadcast"></i></div>
          <h3 class="h5 mt-4">Expand Gospel witness</h3>
          <p class="text-muted mb-0">Reach more interior communities through village outreach, Scripture engagement, and evangelistic follow-up.</p>
        </div>
      </div>
      <div class="col-md-6 col-xl-3">
        <div class="objective-card h-100">
          <div class="icon-badge"><i class="bi bi-journal-bookmark"></i></div>
          <h3 class="h5 mt-4">Deepen discipleship</h3>
          <p class="text-muted mb-0">Help believers grow in biblical understanding, prayer, obedience, and spiritual maturity.</p>
        </div>
      </div>
      <div class="col-md-6 col-xl-3">
        <div class="objective-card h-100">
          <div class="icon-badge"><i class="bi bi-people-fill"></i></div>
          <h3 class="h5 mt-4">Equip leaders and churches</h3>
          <p class="text-muted mb-0">Train pastors and ministry workers so local churches can flourish with wisdom, confidence, and endurance.</p>
        </div>
      </div>
      <div class="col-md-6 col-xl-3">
        <div class="objective-card h-100">
          <div class="icon-badge"><i class="bi bi-heart-pulse"></i></div>
          <h3 class="h5 mt-4">Serve communities holistically</h3>
          <p class="text-muted mb-0">Demonstrate Christs love through child support, family strengthening, literacy initiatives, and practical compassion.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section-pad bg-white mission-action-section">
  <div class="container">
    <div class="row g-5 align-items-center">
      <div class="col-lg-6">
        <span class="eyebrow text-dark">How mission becomes action</span>
        <h2 class="section-title text-dark mt-3">The mission moves from conviction into visible ministry on the ground.</h2>
        <p class="text-muted">For Salone Interior Missions, theology is never detached from people. The mission becomes action when village outreaches are carried out, when children are supported with care and dignity, when pastors gather for encouragement, and when families encounter the compassion of Christ in practical ways.</p>
        <p class="text-muted mb-0">Our organizational direction is simple: remain rooted in Scripture, stay close to communities, strengthen local believers, and invite partners to serve with humility, generosity, and prayer.</p>
      </div>
      <div class="col-lg-6">
        <div class="action-grid">
          <div class="action-item">
            <strong>Evangelize faithfully</strong>
            <span>Share Christ through outreach, teaching, and presence in places often overlooked.</span>
          </div>
          <div class="action-item">
            <strong>Disciple intentionally</strong>
            <span>Form believers and leaders through Scripture, prayer, mentoring, and pastoral care.</span>
          </div>
          <div class="action-item">
            <strong>Strengthen the church</strong>
            <span>Encourage pastors, plant fellowships, and support congregations in their local witness.</span>
          </div>
          <div class="action-item">
            <strong>Serve compassionately</strong>
            <span>Walk with children, families, and communities through practical care that reflects Christs love.</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section-pad donation-cta-section join-mission-section">
  <div class="container">
    <div class="donation-cta d-lg-flex align-items-center justify-content-between gap-4">
      <div>
        <span class="eyebrow">Join the mission</span>
        <h2 class="section-title mt-3 text-white">Pray with us, give with purpose, volunteer in service, or partner in long-term Gospel work.</h2>
      </div>
      <div class="d-flex flex-wrap gap-3 mt-4 mt-lg-0">
        <a href="/donate" class="btn btn-light rounded-pill px-4">Donate Now</a>
        <a href="/contact" class="btn btn-outline-light rounded-pill px-4">Contact Us</a>
      </div>
    </div>
  </div>
</section>
<% } %>

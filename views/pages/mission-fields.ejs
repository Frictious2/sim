<%- include('../partials/page-banner', {
  eyebrow: 'Mission Fields',
  heading: pageRecord && pageRecord.title ? pageRecord.title : 'Where the ministry serves and how the work is taking shape across interior communities.',
  description: pageRecord && pageRecord.subtitle ? pageRecord.subtitle : 'Explore the regions, communities, needs, and ministry activities that define the mission fields of Salone Interior Missions across Sierra Leone.'
}) %>

<%- include('../partials/managed-page-body') %>
<%- include('../partials/managed-page-sections') %>

<% if (!(pageRecord && pageRecord.sections && pageRecord.sections.length)) { %>
<section class="section-pad pt-0 bg-white mission-fields-intro-section">
  <div class="container">
    <div class="row g-5 align-items-center">
      <div class="col-lg-7">
        <span class="eyebrow text-dark">Mission field overview</span>
        <h2 class="section-title text-dark mt-3">Each field tells a story of Gospel outreach, pastoral care, and community transformation.</h2>
        <% if (pageRecord && pageRecord.body) { %>
          <div class="cms-rich-copy text-muted"><%- pageRecord.body %></div>
        <% } else { %>
          <p class="text-muted">Salone Interior Missions serves in communities where spiritual hunger and practical needs often meet. Some areas need stronger church support and leadership training. Others need child sponsorship, literacy help, women empowerment, or sustained outreach presence. In every field, the goal is the same: to make Christ known and to walk with people in ways that strengthen both faith and daily life.</p>
        <% } %>
        <p class="text-muted mb-0">These mission fields are not abstract locations on a map. They are communities with names, families, churches, leaders, and stories. This page helps supporters understand where the work is happening and what kind of transformation is being pursued.</p>
      </div>
      <div class="col-lg-5">
        <div class="content-card h-100 bg-sand">
          <h3 class="h5">Current field emphasis</h3>
          <ul class="check-list mt-3">
            <li>Village evangelism and discipleship follow-up</li>
            <li>Pastor encouragement and leadership formation</li>
            <li>Child support through education and care</li>
            <li>Women and family strengthening initiatives</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>


<section class="section-pad bg-cream region-overview-section">
  <div class="container">
    <div class="row g-4 align-items-stretch">
      <div class="col-lg-7">
        <div class="map-placeholder-card h-100">
          <div class="map-grid">
            <div class="map-region map-region-north">
              <strong>Northern Region</strong>
              <span>Outreach, discipleship, pastor support</span>
            </div>
            <div class="map-region map-region-east">
              <strong>Eastern Region</strong>
              <span>Child support, literacy, church strengthening</span>
            </div>
            <div class="map-region map-region-south">
              <strong>Southern Region</strong>
              <span>Community care, women empowerment, youth ministry</span>
            </div>
            <div class="map-region map-region-central">
              <strong>Growing presence</strong>
              <span>New partnerships and prayer-led field expansion</span>
            </div>
          </div>
          <div class="map-note mt-4">Map-style placeholder for future regional visualization</div>
        </div>
      </div>
      <div class="col-lg-5">
        <div class="content-card h-100">
          <span class="eyebrow text-dark">Regions in focus</span>
          <h2 class="section-title text-dark mt-3">A wide ministry footprint with locally grounded priorities.</h2>
          <p class="text-muted">Our mission fields include remote villages, growing fellowships, education support centers, and communities where practical compassion opens doors for long-term witness.</p>
          <div class="row g-3 mt-2">
            <div class="col-6"><div class="partner-point"><strong>4 regions</strong><span>Serving through relationships, not distance.</span></div></div>
            <div class="col-6"><div class="partner-point"><strong>Multiple needs</strong><span>From evangelism to education and pastoral care.</span></div></div>
            <div class="col-6"><div class="partner-point"><strong>Local partners</strong><span>Church leaders and trusted community contacts.</span></div></div>
            <div class="col-6"><div class="partner-point"><strong>Long-term vision</strong><span>Faithful presence that helps communities flourish.</span></div></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section-pad bg-white mission-field-cards-section">
  <div class="container">
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
      <div>
        <span class="eyebrow text-dark">Mission field cards</span>
        <h2 class="section-title text-dark mt-3">Communities, needs, and featured ministry work.</h2>
      </div>
    </div>
    <div class="row g-4">
      <div class="col-lg-6">
        <article class="field-card h-100">
          <img src="https://images.unsplash.com/photo-1529390079861-591de354faf5?auto=format&fit=crop&w=1200&q=80" alt="Kono District mission field" class="img-fluid rounded-4 field-image mb-4">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
            <h3 class="h4 mb-0">Kono District</h3>
            <span class="badge text-bg-light rounded-pill">Eastern Region</span>
          </div>
          <p class="text-muted">A field where literacy outreach, child support, and pastoral encouragement intersect with the daily realities of rural family life.</p>
          <div class="field-detail"><strong>Key needs:</strong><span>School materials, discipleship follow-up, child sponsorship, and leader support.</span></div>
          <div class="field-detail"><strong>Featured work:</strong><span>Reading circles, childrens discipleship gatherings, and encouragement visits to local churches.</span></div>
        </article>
      </div>
      <div class="col-lg-6">
        <article class="field-card h-100">
          <img src="https://images.unsplash.com/photo-1511632765486-a01980e01a18?auto=format&fit=crop&w=1200&q=80" alt="Northern outreach mission field" class="img-fluid rounded-4 field-image mb-4">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
            <h3 class="h4 mb-0">Northern Outreach Belt</h3>
            <span class="badge text-bg-light rounded-pill">Northern Region</span>
          </div>
          <p class="text-muted">A growing network of villages where evangelism, pastor care, and discipleship gatherings are helping strengthen isolated believers and fellowships.</p>
          <div class="field-detail"><strong>Key needs:</strong><span>Transport for outreach, ministry materials, pastoral training, and prayer support.</span></div>
          <div class="field-detail"><strong>Featured work:</strong><span>Village evangelism, follow-up discipleship, pastors fellowship meetings, and Scripture distribution.</span></div>
        </article>
      </div>
      <div class="col-lg-6">
        <article class="field-card h-100">
          <img src="https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?auto=format&fit=crop&w=1200&q=80" alt="Bo District mission field" class="img-fluid rounded-4 field-image mb-4">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
            <h3 class="h4 mb-0">Bo District Communities</h3>
            <span class="badge text-bg-light rounded-pill">Southern Region</span>
          </div>
          <p class="text-muted">A field where women empowerment, youth discipleship, and practical family support are opening doors for deeper ministry and local resilience.</p>
          <div class="field-detail"><strong>Key needs:</strong><span>Womens training support, youth mentorship, family strengthening, and community care resources.</span></div>
          <div class="field-detail"><strong>Featured work:</strong><span>Prayer groups, enterprise encouragement, youth teaching gatherings, and family support visits.</span></div>
        </article>
      </div>
      <div class="col-lg-6">
        <article class="field-card h-100">
          <img src="https://images.unsplash.com/photo-1517048676732-d65bc937f952?auto=format&fit=crop&w=1200&q=80" alt="Leadership network mission field" class="img-fluid rounded-4 field-image mb-4">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
            <h3 class="h4 mb-0">Leadership Training Network</h3>
            <span class="badge text-bg-light rounded-pill">Cross-regional</span>
          </div>
          <p class="text-muted">A ministry field focused on equipping pastors, evangelists, and emerging leaders who serve faithfully in challenging contexts.</p>
          <div class="field-detail"><strong>Key needs:</strong><span>Biblical training materials, mentoring, fellowship spaces, and consistent encouragement.</span></div>
          <div class="field-detail"><strong>Featured work:</strong><span>Leadership cohorts, teaching modules, pastor retreats, and ministry skills development.</span></div>
        </article>
      </div>
    </div>
  </div>
</section>

<section class="section-pad bg-cream featured-field-story-section">
  <div class="container">
    <div class="row g-5 align-items-center">
      <div class="col-lg-6 order-2 order-lg-1">
        <span class="eyebrow text-dark">Featured field story</span>
        <h2 class="section-title text-dark mt-3">A reading circle in Kono became a place of prayer, confidence, and renewed hope.</h2>
        <p class="text-muted">What began as a simple literacy support effort for children in one interior community gradually became a trusted space for discipleship, encouragement, and family connection. As children returned to learn, parents began asking questions, local leaders became involved, and the ministry widened its reach naturally.</p>
        <p class="text-muted mb-0">This is how many mission fields grow: one faithful step, one relationship, one shared burden at a time. The story of a field is often the story of small acts of faithfulness becoming long-term transformation.</p>
      </div>
      <div class="col-lg-6 order-1 order-lg-2">
        <div class="image-stack-card">
          <img src="https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&w=1200&q=80" alt="Children in reading circle" class="img-fluid rounded-5 field-story-image">
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section-pad bg-white prayer-points-section">
  <div class="container">
    <div class="section-intro text-center mb-5">
      <span class="eyebrow text-dark">Prayer points</span>
      <h2 class="section-title text-dark mt-3">Pray with us for the mission fields and the people they represent.</h2>
    </div>
    <div class="row g-4">
      <div class="col-md-6 col-xl-3">
        <div class="prayer-card h-100">
          <h3 class="h5">Pray for open hearts</h3>
          <p class="text-muted mb-0">Ask God to soften hearts and draw families, children, and leaders toward Christ through the ministry presence in each field.</p>
        </div>
      </div>
      <div class="col-md-6 col-xl-3">
        <div class="prayer-card h-100">
          <h3 class="h5">Pray for pastors and evangelists</h3>
          <p class="text-muted mb-0">Pray for endurance, wisdom, biblical depth, and encouragement for local leaders serving with limited resources.</p>
        </div>
      </div>
      <div class="col-md-6 col-xl-3">
        <div class="prayer-card h-100">
          <h3 class="h5">Pray for children and families</h3>
          <p class="text-muted mb-0">Lift up children who need education support, care, protection, and hopeful pathways into a stable future.</p>
        </div>
      </div>
      <div class="col-md-6 col-xl-3">
        <div class="prayer-card h-100">
          <h3 class="h5">Pray for long-term fruit</h3>
          <p class="text-muted mb-0">Ask God for strong churches, mature disciples, healed relationships, and resilient communities over time.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section-pad donation-cta-section">
  <div class="container">
    <div class="donation-cta d-lg-flex align-items-center justify-content-between gap-4">
      <div>
        <span class="eyebrow">Support this work</span>
        <h2 class="section-title mt-3 text-white">Help strengthen these mission fields through prayer, giving, sponsorship, and ongoing partnership.</h2>
      </div>
      <div class="d-flex flex-wrap gap-3 mt-4 mt-lg-0">
        <a href="/donate" class="btn btn-light rounded-pill px-4">Donate Now</a>
        <a href="/sponsor" class="btn btn-outline-light rounded-pill px-4">Sponsor a Child</a>
      </div>
    </div>
  </div>
</section>
<% } %>

<section class="dashboard-section admin-dashboard-section">
  <div class="content-card admin-panel-card admin-form-card">
    <div class="admin-panel-head">
      <div>
        <h2 class="admin-panel-title mb-1"><%= formTitle %></h2>
        <p class="text-muted mb-0">Use clear summaries and sponsor-ready updates to help supporters understand what this project is accomplishing.</p>
      </div>
      <a href="/admin/sponsorship-projects" class="btn btn-outline-dark rounded-pill btn-sm">Back to Projects</a>
    </div>

    <form action="<%= formAction %>" method="post" class="row g-4 mt-1">
      <div class="col-lg-8"><label class="form-label fw-semibold">Title <span class="text-danger">*</span></label><input class="form-control" name="title" value="<%= project ? project.title : '' %>" required></div>
      <div class="col-lg-4"><label class="form-label fw-semibold">Slug</label><input class="form-control" name="slug" value="<%= project ? project.slug : '' %>"></div>
      <div class="col-md-6"><label class="form-label fw-semibold">Category <span class="text-danger">*</span></label><input class="form-control" name="category" value="<%= project ? project.category : '' %>" required></div>
      <div class="col-md-6"><label class="form-label fw-semibold">Status</label><select class="form-select" name="status"><% projectStatuses.forEach((status) => { %><option value="<%= status %>" <%= project && project.status === status ? 'selected' : '' %>><%= status.replace(/_/g, ' ') %></option><% }) %></select></div>
      <div class="col-md-6"><label class="form-label fw-semibold">Target amount</label><input class="form-control" name="targetAmount" value="<%= project ? project.target_amount : '' %>"></div>
      <div class="col-md-6"><label class="form-label fw-semibold">Current amount</label><input class="form-control" name="currentAmount" value="<%= project ? project.current_amount : '' %>"></div>
      <div class="col-12"><label class="form-label fw-semibold">Image URL</label><input class="form-control" data-image-preview-input="project-image" name="imageUrl" value="<%= project ? project.image_url : '' %>"><div class="form-text">Upload images in Media Library, then paste the URL here.</div></div>
      <div class="col-12"><div class="admin-image-preview-card" data-image-preview-target="project-image"><div class="admin-image-preview-empty">Image preview will appear here.</div></div></div>
      <div class="col-12"><label class="form-label fw-semibold">Summary <span class="text-danger">*</span></label><textarea class="form-control" name="summary" rows="3" required><%= project ? project.summary : '' %></textarea></div>
      <div class="col-12"><label class="form-label fw-semibold">Description <span class="text-danger">*</span></label><textarea class="form-control" name="description" rows="7" required><%= project ? project.description : '' %></textarea></div>
      <div class="col-12 d-flex flex-wrap gap-2"><button type="submit" class="btn btn-sunrise rounded-pill px-4">Save Sponsorship Project</button><a href="/admin/sponsorship-projects" class="btn btn-outline-dark rounded-pill px-4">Cancel</a></div>
    </form>
  </div>
</section>

<% if (typeof updates !== 'undefined' && typeof updateFormAction !== 'undefined') { %>
<section class="dashboard-section admin-dashboard-section pt-0">
  <div class="content-card admin-panel-card admin-form-card">
    <div class="admin-panel-head"><div><h2 class="admin-panel-title mb-1">Project updates</h2><p class="text-muted mb-0">Share milestones, field progress, and sponsor-only updates for this project.</p></div></div>
    <form action="<%= updateFormAction %>" method="post" class="row g-4 mt-1">
      <div class="col-md-6"><label class="form-label fw-semibold">Update title <span class="text-danger">*</span></label><input class="form-control" name="title" value="<%= updateForm ? updateForm.title : '' %>" required></div>
      <div class="col-md-6"><label class="form-label fw-semibold">Visibility</label><select class="form-select" name="visibility"><% ['public','sponsors_only'].forEach((visibility) => { %><option value="<%= visibility %>" <%= updateForm && updateForm.visibility === visibility ? 'selected' : '' %>><%= visibility.replace(/_/g, ' ') %></option><% }) %></select></div>
      <div class="col-12"><label class="form-label fw-semibold">Image URL</label><input class="form-control" name="imageUrl" value="<%= updateForm ? updateForm.image_url : '' %>"></div>
      <div class="col-12"><label class="form-label fw-semibold">Update text <span class="text-danger">*</span></label><textarea class="form-control" name="updateText" rows="6" required><%= updateForm ? updateForm.update_text : '' %></textarea></div>
      <div class="col-12 d-flex flex-wrap gap-2"><button type="submit" class="btn btn-sunrise rounded-pill px-4">Save Update</button><% if (updateForm && updateForm.id) { %><a href="/admin/sponsorship-projects/<%= project.id %>/edit" class="btn btn-outline-dark rounded-pill px-4">Cancel Edit</a><% } %></div>
    </form>

    <% if (updates && updates.length) { %>
      <div class="table-responsive mt-4"><table class="table admin-table align-middle mb-0"><thead><tr><th>Title</th><th>Visibility</th><th>Created</th><th class="text-end">Actions</th></tr></thead><tbody><% updates.forEach((item) => { %><tr><td><div class="fw-semibold"><%= item.title %></div></td><td><%= item.visibilityLabel %></td><td><%= item.createdDisplay %></td><td class="text-end"><div class="d-flex justify-content-end gap-2 flex-wrap"><a href="/admin/sponsorship-projects/<%= project.id %>/edit?update=<%= item.id %>" class="btn btn-outline-dark btn-sm rounded-pill">Edit</a><form method="post" action="/admin/sponsorship-projects/<%= project.id %>/updates/<%= item.id %>/archive" class="d-inline"><button type="submit" class="btn btn-outline-danger btn-sm rounded-pill">Archive</button></form></div></td></tr><% }) %></tbody></table></div>
    <% } %>
  </div>
</section>
<% } %>

<section class="dashboard-section"><div class="content-card"><h2 class="h4">Blog posts</h2><div class="table-responsive mt-3"><table class="table align-middle"><thead><tr><th>Title</th><th>Category</th><th>Author</th><th>Date</th></tr></thead><tbody><% content.blogPosts.forEach((item) => { %><tr><td><%= item.title %></td><td><%= item.category %></td><td><%= item.author %></td><td><%= item.date %></td></tr><% }) %></tbody></table></div></div></section>

<section class="dashboard-section admin-dashboard-section"><div class="content-card admin-panel-card"><div class="admin-panel-head"><div><h2 class="admin-panel-title mb-1">Sponsorship interest details</h2><p class="text-muted mb-0">Review supporter preferences and record the next step your team takes.</p></div><a href="/admin/sponsorships" class="btn btn-outline-dark rounded-pill btn-sm">Back to sponsorships</a></div><div class="row g-4 mt-1"><div class="col-lg-7"><div class="admin-detail-stack"><div class="admin-detail-card"><span>Name</span><strong><%= sponsorship.sponsor_name %></strong></div><div class="admin-detail-card"><span>Email</span><strong><%= sponsorship.sponsor_email %></strong></div><div class="admin-detail-card"><span>Phone</span><strong><%= sponsorship.sponsor_phone || 'Not provided' %></strong></div><div class="admin-detail-card"><span>Type</span><strong><%= sponsorship.sponsorshipTypeLabel %></strong></div><div class="admin-detail-card"><span>Preferred plan</span><strong><%= sponsorship.preferredPlanLabel %></strong></div><div class="admin-detail-card"><span>Preferred amount</span><strong><%= sponsorship.amountDisplay %></strong></div><div class="admin-detail-card"><span>Preferred contact method</span><strong><%= sponsorship.preferred_contact_method || 'No preference shared' %></strong></div><div class="admin-detail-card"><span>Status</span><strong><%= sponsorship.statusLabel %></strong></div><div class="admin-detail-card"><span>Submitted</span><strong><%= sponsorship.createdDisplay %></strong></div><% if (sponsorship.reviewedDisplay) { %><div class="admin-detail-card"><span>Reviewed</span><strong><%= sponsorship.reviewedDisplay %></strong></div><% } %></div><div class="content-card mt-4"><h3 class="h5 mb-3">Sponsor message</h3><p class="text-muted mb-0"><%= sponsorship.message || 'No message was included with this interest submission.' %></p></div><div class="content-card mt-4"><h3 class="h5 mb-3">Internal note history</h3><% if (notes && notes.length) { %><div class="timeline-list"><% notes.forEach((note) => { %><div class="timeline-item"><strong><%= note.created_by_name || 'Admin note' %></strong><div class="small text-muted"><%= note.createdDisplay %></div><div class="text-muted mt-1"><%= note.note %></div></div><% }) %></div><% } else { %><p class="text-muted mb-0">No internal notes recorded yet.</p><% } %></div></div><div class="col-lg-5"><div class="content-card"><h3 class="h5 mb-3">Update status</h3><div class="d-grid gap-3"><form method="post" action="/admin/sponsorships/<%= sponsorship.id %>/contacted"><input type="hidden" name="redirectTo" value="detail"><button type="submit" class="btn btn-outline-dark rounded-pill w-100">Mark Contacted</button></form><form method="post" action="/admin/sponsorships/<%= sponsorship.id %>/approve"><input type="hidden" name="redirectTo" value="detail"><button type="submit" class="btn btn-sunrise rounded-pill w-100">Approve Interest</button></form><form method="post" action="/admin/sponsorships/<%= sponsorship.id %>/reject"><input type="hidden" name="redirectTo" value="detail"><textarea class="form-control mb-2" name="adminNote" rows="3" placeholder="Optional note for the rejection decision"></textarea><button type="submit" class="btn btn-outline-dark rounded-pill w-100">Reject Interest</button></form><form method="post" action="/admin/sponsorships/<%= sponsorship.id %>/archive"><input type="hidden" name="redirectTo" value="detail"><button type="submit" class="btn btn-outline-secondary rounded-pill w-100">Archive Interest</button></form></div></div><div class="content-card mt-4 bg-sand"><h3 class="h5 mb-3">Add internal note</h3><form method="post" action="/admin/sponsorships/<%= sponsorship.id %>/note"><textarea class="form-control mb-3" name="adminNote" rows="5" placeholder="Record your next step, assignment idea, or follow-up note"></textarea><button type="submit" class="btn btn-outline-dark rounded-pill w-100">Save Note</button></form></div></div></div></div></section>

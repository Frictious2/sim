<section class="dashboard-section"><div class="content-card"><h2 class="h4">Sponsorships</h2><div class="table-responsive mt-3"><table class="table align-middle"><thead><tr><th>Sponsor type</th><th>Target</th><th>Suggested amount</th><th>Status</th></tr></thead><tbody><% content.userSponsorships.forEach((item) => { %><tr><td><%= item.type %></td><td><%= item.target %></td><td><%= item.amount %></td><td><span class="badge text-bg-success-subtle text-success"><%= item.status %></span></td></tr><% }) %></tbody></table></div></div></section>

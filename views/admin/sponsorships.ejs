<section class="dashboard-section admin-dashboard-section">
  <div class="content-card admin-panel-card">
    <div class="admin-toolbar"><div><h2 class="admin-panel-title mb-1">Sponsorship interests</h2><p class="text-muted mb-0">Review incoming sponsorship interests, update status, and keep internal notes alongside each response.</p></div></div>
    <form class="admin-filter-bar mt-4" method="get" action="/admin/sponsorships">
      <input class="form-control" type="search" name="q" value="<%= filters.q %>" placeholder="Search sponsor names, emails, or messages">
      <select class="form-select" name="status"><option value="">All statuses</option><% sponsorshipStatuses.forEach((status) => { %><option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= status.replace(/_/g, ' ').replace(/w/g, (char) => char.toUpperCase()) %></option><% }) %></select>
      <select class="form-select" name="sponsorshipType"><option value="">All sponsorship types</option><% sponsorshipTypes.forEach((type) => { %><option value="<%= type %>" <%= filters.sponsorshipType === type ? 'selected' : '' %>><%= type.replace(/_/g, ' ').replace(/w/g, (char) => char.toUpperCase()) %></option><% }) %></select>
      <select class="form-select" name="preferredPlan"><option value="">All plans</option><% sponsorshipPlans.forEach((plan) => { %><option value="<%= plan %>" <%= filters.preferredPlan === plan ? 'selected' : '' %>><%= plan.replace(/_/g, ' ').replace(/w/g, (char) => char.toUpperCase()) %></option><% }) %></select>
      <button type="submit" class="btn btn-outline-dark rounded-pill">Filter</button><a href="/admin/sponsorships" class="btn btn-outline-secondary rounded-pill">Reset</a>
    </form>
    <div class="admin-list-summary mt-3">Showing <strong><%= pagination.from %>-<%= pagination.to %></strong> of <strong><%= pagination.total %></strong> sponsorship interests</div>
    <div class="table-responsive mt-3"><table class="table align-middle dashboard-table mb-0"><thead><tr><th>Sponsor</th><th>Type</th><th>Plan</th><th>Amount</th><th>Status</th><th>Submitted</th><th>Actions</th></tr></thead><tbody><% if (sponsorships.length) { %><% sponsorships.forEach((item) => { %><tr><td><strong><%= item.sponsor_name %></strong><div class="small text-muted"><%= item.sponsor_email %></div></td><td><%= item.sponsorshipTypeLabel %></td><td><%= item.preferredPlanLabel %></td><td><%= item.amountDisplay %></td><td><span class="badge <%= item.statusBadgeClass %>"><%= item.statusLabel %></span></td><td><%= item.createdDisplay %></td><td><div class="table-actions"><a href="/admin/sponsorships/<%= item.id %>" class="btn btn-outline-dark btn-sm rounded-pill">View</a><% if (item.status !== 'contacted') { %><form action="/admin/sponsorships/<%= item.id %>/contacted" method="post" class="d-inline"><button type="submit" class="btn btn-outline-dark btn-sm rounded-pill">Mark Contacted</button></form><% } %><% if (item.status !== 'approved') { %><form action="/admin/sponsorships/<%= item.id %>/approve" method="post" class="d-inline"><button type="submit" class="btn btn-outline-dark btn-sm rounded-pill">Approve</button></form><% } %></div></td></tr><% }) %><% } else { %><tr><td colspan="7"><div class="admin-empty-state"><div class="empty-state-icon"><i class="bi bi-people"></i></div><h3 class="h5 mb-2">No sponsorship interests match this view</h3><p class="text-muted mb-0">New sponsorship enquiries from the public sponsor page will appear here for review.</p></div></td></tr><% } %></tbody></table></div>
    <%- include('../partials/pagination', { pagination, filters }) %>
  </div>
</section>

<section class="dashboard-section admin-dashboard-section">
  <div class="content-card admin-panel-card admin-form-card">
    <div class="admin-panel-head">
      <div>
        <h2 class="admin-panel-title mb-1"><%= formTitle %></h2>
        <p class="text-muted mb-0">This content feeds the existing public layout rather than replacing the design.</p>
      </div>
      <a href="/admin/pages" class="btn btn-outline-dark rounded-pill btn-sm">Back to Pages</a>
    </div>

    <form action="<%= formAction %>" method="post" class="row g-4 mt-1">
      <div class="col-lg-8">
        <label class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
        <input class="form-control" name="title" id="pageTitleField" data-slug-source data-slug-target="pageSlug" value="<%= pageItem ? pageItem.title : '' %>" required>
      </div>
      <div class="col-lg-4">
        <label class="form-label fw-semibold">Slug</label>
        <input class="form-control" id="pageSlug" data-slug-field name="slug" value="<%= pageItem ? pageItem.slug : '' %>" placeholder="Auto-generated if left blank">
      </div>
      <div class="col-lg-8">
        <label class="form-label fw-semibold">Subtitle</label>
        <input class="form-control" name="subtitle" value="<%= pageItem ? (pageItem.subtitle || '') : '' %>">
      </div>
      <div class="col-lg-4">
        <label class="form-label fw-semibold">Status <span class="text-danger">*</span></label>
        <select class="form-select" name="status">
          <% ['draft', 'published'].forEach((status) => { %>
            <option value="<%= status %>" <%= pageItem && pageItem.status === status ? 'selected' : (!pageItem && status === 'draft' ? 'selected' : '') %>><%= status.charAt(0).toUpperCase() + status.slice(1) %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-12">
        <%- include('../partials/rich-text-editor', {
          label: 'Body',
          required: false,
          helperText: 'This body content appears inside the designed public layout, so use it for flexible editorial copy rather than full-page structure.',
          fieldId: 'pageBody',
          name: 'body',
          value: pageItem ? (pageItem.body || '') : '',
          placeholder: 'Add rich body content for this page...'
        }) %>
      </div>
      <div class="col-md-6">
        <label class="form-label fw-semibold">Meta title</label>
        <input class="form-control" name="metaTitle" value="<%= pageItem ? (pageItem.meta_title || '') : '' %>">
      </div>
      <div class="col-md-6">
        <label class="form-label fw-semibold">Meta description</label>
        <input class="form-control" data-character-count-target="page-meta-count" name="metaDescription" value="<%= pageItem ? (pageItem.meta_description || '') : '' %>">
        <div class="d-flex justify-content-between form-text">
          <span>Helpful for search previews and page sharing.</span>
          <span><span data-character-count="page-meta-count">0</span> characters</span>
        </div>
      </div>
      <div class="col-12 d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-sunrise rounded-pill px-4">Save Page</button>
        <a href="/admin/pages" class="btn btn-outline-dark rounded-pill px-4">Cancel</a>
      </div>
    </form>
  </div>
</section>

<% if (pageItem && pageItem.id) { %>
  <section class="dashboard-section admin-dashboard-section pt-0">
    <div class="content-card admin-panel-card">
      <div class="admin-toolbar">
        <div>
          <h2 class="admin-panel-title mb-1">Managed page sections</h2>
          <p class="text-muted mb-0">Add editable text, images, and CTA blocks for this page. These render on the public page in sort order.</p>
        </div>
        <a href="/admin/pages/<%= pageItem.id %>/sections/create" class="btn btn-sunrise rounded-pill">Add Section</a>
      </div>

      <div class="table-responsive mt-4">
        <table class="table align-middle dashboard-table mb-0">
          <thead>
            <tr>
              <th>Order</th>
              <th>Section key</th>
              <th>Title</th>
              <th>Image</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (typeof pageSections !== 'undefined' && pageSections.length) { %>
              <% pageSections.forEach((sectionItem) => { %>
                <tr>
                  <td><%= sectionItem.sort_order %></td>
                  <td><code><%= sectionItem.section_key %></code></td>
                  <td><strong><%= sectionItem.title || sectionItem.eyebrow || 'Untitled section' %></strong></td>
                  <td><%= sectionItem.image_url ? 'Configured' : 'None' %></td>
                  <td><span class="badge <%= sectionItem.is_active ? 'text-bg-success-subtle text-success' : 'text-bg-light text-dark' %>"><%= sectionItem.is_active ? 'Active' : 'Inactive' %></span></td>
                  <td>
                    <div class="table-actions">
                      <a href="/admin/pages/<%= pageItem.id %>/sections/<%= sectionItem.id %>/edit" class="btn btn-outline-dark btn-sm rounded-pill">Edit</a>
                      <form action="/admin/pages/<%= pageItem.id %>/sections/<%= sectionItem.id %>/delete" method="post" class="d-inline">
                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill">Delete</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6">
                  <div class="admin-empty-state">
                    <h3 class="h5 mb-2">No managed sections yet</h3>
                    <p class="text-muted mb-3">Add sections to make more of this page editable, including images and CTA buttons.</p>
                    <a href="/admin/pages/<%= pageItem.id %>/sections/create" class="btn btn-sunrise rounded-pill btn-sm">Add First Section</a>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
<% } %>

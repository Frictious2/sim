<section class="dashboard-section admin-dashboard-section"><div class="content-card admin-panel-card"><div class="admin-panel-head"><div><h2 class="admin-panel-title mb-1">Volunteer application details</h2><p class="text-muted mb-0">Review the applicant profile and keep the next step clearly recorded.</p></div><a href="/admin/volunteers" class="btn btn-outline-dark rounded-pill btn-sm">Back to applications</a></div><div class="row g-4 mt-1"><div class="col-lg-7"><div class="admin-detail-stack"><div class="admin-detail-card"><span>Name</span><strong><%= volunteer.full_name %></strong></div><div class="admin-detail-card"><span>Email</span><strong><%= volunteer.email %></strong></div><div class="admin-detail-card"><span>Phone</span><strong><%= volunteer.phone || 'Not provided' %></strong></div><div class="admin-detail-card"><span>Location</span><strong><%= volunteer.location || 'Not provided' %></strong></div><div class="admin-detail-card"><span>Area of interest</span><strong><%= volunteer.areaLabel %></strong></div><div class="admin-detail-card"><span>Availability</span><strong><%= volunteer.availability || 'Not provided' %></strong></div><div class="admin-detail-card"><span>Status</span><strong><%= volunteer.statusLabel %></strong></div><div class="admin-detail-card"><span>Submitted</span><strong><%= volunteer.createdDisplay %></strong></div><% if (volunteer.reviewedDisplay) { %><div class="admin-detail-card"><span>Reviewed</span><strong><%= volunteer.reviewedDisplay %></strong></div><% } %></div><div class="content-card mt-4"><h3 class="h5 mb-3">Experience</h3><p class="text-muted mb-0"><%= volunteer.experience || 'No prior experience details were supplied.' %></p></div><div class="content-card mt-4"><h3 class="h5 mb-3">Motivation</h3><p class="text-muted mb-0"><%= volunteer.motivation || 'No motivation statement was supplied.' %></p></div><div class="content-card mt-4"><h3 class="h5 mb-3">Internal note history</h3><% if (notes && notes.length) { %><div class="timeline-list"><% notes.forEach((note) => { %><div class="timeline-item"><strong><%= note.created_by_name || 'Admin note' %></strong><div class="small text-muted"><%= note.createdDisplay %></div><div class="text-muted mt-1"><%= note.note %></div></div><% }) %></div><% } else { %><p class="text-muted mb-0">No internal notes recorded yet.</p><% } %></div></div><div class="col-lg-5"><div class="content-card"><h3 class="h5 mb-3">Update status</h3><div class="d-grid gap-3"><form method="post" action="/admin/volunteers/<%= volunteer.id %>/reviewing"><input type="hidden" name="redirectTo" value="detail"><button type="submit" class="btn btn-outline-dark rounded-pill w-100">Move to Reviewing</button></form><form method="post" action="/admin/volunteers/<%= volunteer.id %>/approve"><input type="hidden" name="redirectTo" value="detail"><button type="submit" class="btn btn-sunrise rounded-pill w-100">Approve Application</button></form><form method="post" action="/admin/volunteers/<%= volunteer.id %>/reject"><input type="hidden" name="redirectTo" value="detail"><textarea class="form-control mb-2" name="adminNote" rows="3" placeholder="Optional note explaining the rejection"></textarea><button type="submit" class="btn btn-outline-dark rounded-pill w-100">Reject Application</button></form><form method="post" action="/admin/volunteers/<%= volunteer.id %>/archive"><input type="hidden" name="redirectTo" value="detail"><button type="submit" class="btn btn-outline-secondary rounded-pill w-100">Archive Application</button></form></div></div><div class="content-card mt-4 bg-sand"><h3 class="h5 mb-3">Add internal note</h3><form method="post" action="/admin/volunteers/<%= volunteer.id %>/note"><textarea class="form-control mb-3" name="adminNote" rows="5" placeholder="Record interview notes or next-step reminders"></textarea><button type="submit" class="btn btn-outline-dark rounded-pill w-100">Save Note</button></form></div></div></div></div></section>

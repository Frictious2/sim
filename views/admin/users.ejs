<section class="dashboard-section"><div class="content-card"><h2 class="h4">Users</h2><div class="table-responsive mt-3"><table class="table align-middle"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Joined</th></tr></thead><tbody><% content.adminUsers.forEach((item) => { %><tr><td><%= item.name %></td><td><%= item.email %></td><td><span class="badge text-bg-light"><%= item.role %></span></td><td><%= item.joined %></td></tr><% }) %></tbody></table></div></div></section>

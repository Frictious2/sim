<section class="dashboard-section admin-dashboard-section">
  <div class="content-card admin-panel-card">
    <div class="admin-panel-head">
      <div>
        <h2 class="admin-panel-title mb-1">Gallery items</h2>
        <p class="text-muted mb-0">Manage published, draft, and archived gallery images for the public gallery page.</p>
      </div>
      <a href="/admin/gallery/create" class="btn btn-sunrise rounded-pill">Create Gallery Item</a>
    </div>

    <form class="admin-filter-bar mt-4" method="get" action="/admin/gallery">
      <input class="form-control" type="search" name="q" value="<%= filters.q %>" placeholder="Search titles, captions, or categories">
      <select class="form-select" name="status">
        <option value="">All statuses</option>
        <% ['draft', 'published', 'archived'].forEach((status) => { %>
          <option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= status.charAt(0).toUpperCase() + status.slice(1) %></option>
        <% }) %>
      </select>
      <select class="form-select" name="category">
        <option value="">All categories</option>
        <% categories.forEach((category) => { %>
          <option value="<%= category %>" <%= filters.category === category ? 'selected' : '' %>><%= category %></option>
        <% }) %>
      </select>
      <button type="submit" class="btn btn-outline-dark rounded-pill">Filter</button>
      <a href="/admin/gallery" class="btn btn-outline-secondary rounded-pill">Reset</a>
    </form>

    <% if (galleryItems.length) { %>
      <div class="table-responsive mt-3">
        <table class="table admin-table align-middle mb-0">
          <thead>
            <tr>
              <th>Image</th>
              <th>Title</th>
              <th>Category</th>
              <th>Status</th>
              <th>Sort</th>
              <th>Updated</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% galleryItems.forEach((item) => { %>
              <tr>
                <td><img src="<%= item.image_url %>" alt="<%= item.title %>" class="admin-thumb rounded-3"></td>
                <td>
                  <div class="fw-semibold"><%= item.title %></div>
                  <small class="text-muted d-block"><%= item.caption || 'No caption yet' %></small>
                </td>
                <td><%= item.category || 'General' %></td>
                <td><span class="badge <%= item.statusBadgeClass %>"><%= item.statusLabel %></span></td>
                <td><%= item.sort_order %></td>
                <td><%= item.updatedDisplay %></td>
                <td class="text-end">
                  <div class="d-flex justify-content-end flex-wrap gap-2">
                    <a href="/admin/gallery/<%= item.id %>/edit" class="btn btn-outline-dark btn-sm rounded-pill">Edit</a>
                    <form action="/admin/gallery/<%= item.id %>/archive" method="post" class="d-inline">
                      <button type="submit" class="btn btn-outline-dark btn-sm rounded-pill">Archive</button>
                    </form>
                    <form action="/admin/gallery/<%= item.id %>/delete" method="post" class="d-inline">
                      <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="admin-empty-state mt-3">
        <div class="empty-state-icon"><i class="bi bi-images"></i></div>
        <h3 class="h5 mb-2">No gallery items match this view</h3>
        <p class="text-muted mb-3">Create gallery records here after uploading images in the media library.</p>
        <a href="/admin/gallery/create" class="btn btn-sunrise rounded-pill">Create First Gallery Item</a>
      </div>
    <% } %>

    <%- include('../partials/pagination', { pagination, filters }) %>
  </div>
</section>

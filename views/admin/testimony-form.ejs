<section class="dashboard-section admin-dashboard-section">
  <div class="content-card admin-panel-card admin-form-card">
    <div class="admin-panel-head">
      <div>
        <h2 class="admin-panel-title mb-1"><%= formTitle %></h2>
        <p class="text-muted mb-0">Shape the testimony story with the same care used in public ministry storytelling.</p>
      </div>
      <a href="/admin/testimonies" class="btn btn-outline-dark rounded-pill btn-sm">Back to Testimonies</a>
    </div>

    <form action="<%= formAction %>" method="post" class="row g-4 mt-1">
      <div class="col-lg-6">
        <label class="form-label fw-semibold">Name <span class="text-danger">*</span></label>
        <input class="form-control" name="name" value="<%= testimony ? testimony.name : '' %>" required>
      </div>
      <div class="col-lg-6">
        <label class="form-label fw-semibold">Location</label>
        <input class="form-control" name="location" value="<%= testimony ? (testimony.location || '') : '' %>">
      </div>
      <div class="col-lg-6">
        <label class="form-label fw-semibold">Status <span class="text-danger">*</span></label>
        <select class="form-select" name="status">
          <% ['draft', 'published', 'archived'].forEach((status) => { %>
            <option value="<%= status %>" <%= testimony && testimony.status === status ? 'selected' : (!testimony && status === 'draft' ? 'selected' : '') %>><%= status.charAt(0).toUpperCase() + status.slice(1) %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-lg-6">
        <div class="form-check mt-lg-5 pt-lg-2">
          <input class="form-check-input" type="checkbox" name="isFeatured" id="isFeatured" <%= testimony && testimony.is_featured ? 'checked' : '' %>>
          <label class="form-check-label" for="isFeatured">Feature this testimony</label>
        </div>
      </div>
      <div class="col-12">
        <label class="form-label fw-semibold">Image URL</label>
        <input class="form-control" data-image-preview-input="testimony-image" name="imageUrl" value="<%= testimony ? (testimony.image_url || '') : '' %>" placeholder="/uploads/media/example.webp">
        <div class="form-text">Upload images in Media Library, then paste the media URL here.</div>
      </div>
      <div class="col-12">
        <div class="admin-image-preview-card" data-image-preview-target="testimony-image">
          <div class="admin-image-preview-empty">Image preview will appear here.</div>
        </div>
      </div>
      <div class="col-12">
        <label class="form-label fw-semibold">Quote <span class="text-danger">*</span></label>
        <textarea class="form-control" data-character-count-target="testimony-quote-count" name="quote" rows="4" required><%= testimony ? testimony.quote : '' %></textarea>
        <div class="d-flex justify-content-between form-text">
          <span>This shorter quote is used in cards and featured testimony callouts.</span>
          <span><span data-character-count="testimony-quote-count">0</span> characters</span>
        </div>
      </div>
      <div class="col-12">
        <%- include('../partials/rich-text-editor', {
          label: 'Story',
          required: false,
          helperText: 'Add fuller story context, reflection, and ministry detail for richer testimony presentation.',
          fieldId: 'testimonyStory',
          name: 'story',
          value: testimony ? (testimony.story || '') : '',
          placeholder: 'Write the fuller testimony story here...'
        }) %>
      </div>
      <div class="col-12 d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-sunrise rounded-pill px-4">Save Testimony</button>
        <a href="/admin/testimonies" class="btn btn-outline-dark rounded-pill px-4">Cancel</a>
      </div>
    </form>
  </div>
</section>

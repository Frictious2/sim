<section class="dashboard-section admin-dashboard-section">
  <div class="content-card admin-panel-card admin-form-card">
    <div class="admin-panel-head">
      <div>
        <h2 class="admin-panel-title mb-1"><%= formTitle %></h2>
        <p class="text-muted mb-0">Use this profile to explain where the worker serves, how they minister, and how supporters can pray wisely.</p>
      </div>
      <a href="/admin/mission-workers" class="btn btn-outline-dark rounded-pill btn-sm">Back to Mission Workers</a>
    </div>

    <form action="<%= formAction %>" method="post" class="row g-4 mt-1">
      <div class="col-md-6"><label class="form-label fw-semibold">First name <span class="text-danger">*</span></label><input class="form-control" name="firstName" value="<%= worker ? worker.first_name : '' %>" required></div>
      <div class="col-md-6"><label class="form-label fw-semibold">Last name <span class="text-danger">*</span></label><input class="form-control" name="lastName" value="<%= worker ? worker.last_name : '' %>" required></div>
      <div class="col-md-6"><label class="form-label fw-semibold">Location <span class="text-danger">*</span></label><input class="form-control" name="location" value="<%= worker ? worker.location : '' %>" required></div>
      <div class="col-md-6"><label class="form-label fw-semibold">Status</label><select class="form-select" name="status"><% workerStatuses.forEach((status) => { %><option value="<%= status %>" <%= worker && worker.status === status ? 'selected' : '' %>><%= status.replace(/_/g, ' ') %></option><% }) %></select></div>
      <div class="col-md-8"><label class="form-label fw-semibold">Ministry focus <span class="text-danger">*</span></label><input class="form-control" name="ministryFocus" value="<%= worker ? worker.ministry_focus : '' %>" required></div>
      <div class="col-md-4"><label class="form-label fw-semibold">Support target</label><input class="form-control" name="supportTarget" value="<%= worker ? worker.support_target : '' %>"></div>
      <div class="col-12"><label class="form-label fw-semibold">Profile image URL</label><input class="form-control" data-image-preview-input="worker-image" name="profileImageUrl" value="<%= worker ? worker.profile_image_url : '' %>"><div class="form-text">Upload images in Media Library, then paste the URL here.</div></div>
      <div class="col-12"><div class="admin-image-preview-card" data-image-preview-target="worker-image"><div class="admin-image-preview-empty">Image preview will appear here.</div></div></div>
      <div class="col-12"><label class="form-label fw-semibold">Biography</label><textarea class="form-control" name="biography" rows="6"><%= worker ? worker.biography : '' %></textarea></div>
      <div class="col-12 d-flex flex-wrap gap-2"><button type="submit" class="btn btn-sunrise rounded-pill px-4">Save Mission Worker</button><a href="/admin/mission-workers" class="btn btn-outline-dark rounded-pill px-4">Cancel</a></div>
    </form>
  </div>
</section>

<% if (typeof updates !== 'undefined' && typeof updateFormAction !== 'undefined') { %>
<section class="dashboard-section admin-dashboard-section pt-0">
  <div class="content-card admin-panel-card admin-form-card">
    <div class="admin-panel-head"><div><h2 class="admin-panel-title mb-1">Mission worker updates</h2><p class="text-muted mb-0">Record field progress, encouragement, and sponsor communication for this worker.</p></div></div>
    <form action="<%= updateFormAction %>" method="post" class="row g-4 mt-1">
      <div class="col-md-6"><label class="form-label fw-semibold">Update title <span class="text-danger">*</span></label><input class="form-control" name="title" value="<%= updateForm ? updateForm.title : '' %>" required></div>
      <div class="col-md-6"><label class="form-label fw-semibold">Visibility</label><select class="form-select" name="visibility"><% ['public','sponsors_only'].forEach((visibility) => { %><option value="<%= visibility %>" <%= updateForm && updateForm.visibility === visibility ? 'selected' : '' %>><%= visibility.replace(/_/g, ' ') %></option><% }) %></select></div>
      <div class="col-12"><label class="form-label fw-semibold">Image URL</label><input class="form-control" name="imageUrl" value="<%= updateForm ? updateForm.image_url : '' %>"></div>
      <div class="col-12"><label class="form-label fw-semibold">Update text <span class="text-danger">*</span></label><textarea class="form-control" name="updateText" rows="6" required><%= updateForm ? updateForm.update_text : '' %></textarea></div>
      <div class="col-12 d-flex flex-wrap gap-2"><button type="submit" class="btn btn-sunrise rounded-pill px-4">Save Update</button><% if (updateForm && updateForm.id) { %><a href="/admin/mission-workers/<%= worker.id %>/edit" class="btn btn-outline-dark rounded-pill px-4">Cancel Edit</a><% } %></div>
    </form>

    <% if (updates && updates.length) { %>
      <div class="table-responsive mt-4"><table class="table admin-table align-middle mb-0"><thead><tr><th>Title</th><th>Visibility</th><th>Created</th><th class="text-end">Actions</th></tr></thead><tbody><% updates.forEach((item) => { %><tr><td><div class="fw-semibold"><%= item.title %></div></td><td><%= item.visibilityLabel %></td><td><%= item.createdDisplay %></td><td class="text-end"><div class="d-flex justify-content-end gap-2 flex-wrap"><a href="/admin/mission-workers/<%= worker.id %>/edit?update=<%= item.id %>" class="btn btn-outline-dark btn-sm rounded-pill">Edit</a><form method="post" action="/admin/mission-workers/<%= worker.id %>/updates/<%= item.id %>/archive" class="d-inline"><button type="submit" class="btn btn-outline-danger btn-sm rounded-pill">Archive</button></form></div></td></tr><% }) %></tbody></table></div>
    <% } %>
  </div>
</section>
<% } %>

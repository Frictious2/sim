<section class="dashboard-section admin-dashboard-section"><div class="row g-4"><div class="col-12 col-xxl-6"><div class="content-card admin-panel-card h-100"><div class="admin-toolbar"><div><h2 class="admin-panel-title mb-1">Prayer partners</h2><p class="text-muted mb-0">Review active prayer supporters and keep their prayer focus up to date.</p></div></div><form class="admin-filter-bar mt-4" method="get" action="/admin/prayer"><input class="form-control" type="search" name="partnerQ" value="<%= partnerFilters.q %>" placeholder="Search partner names or emails"><select class="form-select" name="partnerStatus"><option value="">All statuses</option><% prayerPartnerStatuses.forEach((status) => { %><option value="<%= status %>" <%= partnerFilters.status === status ? 'selected' : '' %>><%= status.replace(/_/g, ' ').replace(/w/g, (char) => char.toUpperCase()) %></option><% }) %></select><select class="form-select" name="prayerFocus"><option value="">All focus areas</option><% prayerFocusValues.forEach((focus) => { %><option value="<%= focus %>" <%= partnerFilters.prayerFocus === focus ? 'selected' : '' %>><%= focus.replace(/_/g, ' ').replace(/w/g, (char) => char.toUpperCase()) %></option><% }) %></select><button type="submit" class="btn btn-outline-dark rounded-pill">Filter</button></form><div class="table-responsive mt-4"><table class="table align-middle dashboard-table mb-0"><thead><tr><th>Name</th><th>Focus</th><th>Frequency</th><th>Status</th><th>Actions</th></tr></thead><tbody><% if (prayerPartners.length) { %><% prayerPartners.forEach((item) => { %><tr><td><strong><%= item.name %></strong><div class="small text-muted"><%= item.email %></div></td><td><%= item.focusLabel %></td><td><%= item.frequencyLabel %></td><td><span class="badge <%= item.status === 'active' ? 'text-bg-success-subtle text-success' : 'text-bg-light text-dark' %>"><%= item.statusLabel %></span></td><td><form method="post" action="/admin/prayer/partners/<%= item.id %>/status" class="d-flex gap-2"><select class="form-select form-select-sm" name="status"><% prayerPartnerStatuses.forEach((status) => { %><option value="<%= status %>" <%= item.status === status ? 'selected' : '' %>><%= status.replace(/_/g, ' ').replace(/w/g, (char) => char.toUpperCase()) %></option><% }) %></select><button type="submit" class="btn btn-outline-dark btn-sm rounded-pill">Save</button></form></td></tr><% }) %><% } else { %><tr><td colspan="5"><div class="admin-empty-state"><div class="empty-state-icon"><i class="bi bi-stars"></i></div><h3 class="h5 mb-2">No prayer partners yet</h3><p class="text-muted mb-0">Prayer partner signups from the public site will appear here.</p></div></td></tr><% } %></tbody></table></div><%- include('../partials/pagination', { pagination: partnerPagination, filters: { partnerQ: partnerFilters.q, partnerStatus: partnerFilters.status, prayerFocus: partnerFilters.prayerFocus, requestQ: requestFilters.q, requestStatus: requestFilters.status, isPublic: requestFilters.isPublic, requestPage: requestPagination.page, requestLimit: requestPagination.limit } }) %></div></div><div class="col-12 col-xxl-6"><div class="content-card admin-panel-card h-100"><div class="admin-toolbar"><div><h2 class="admin-panel-title mb-1">Prayer requests</h2><p class="text-muted mb-0">Track submitted requests and move them through review, prayer, and archive stages.</p></div></div><form class="admin-filter-bar mt-4" method="get" action="/admin/prayer"><input class="form-control" type="search" name="requestQ" value="<%= requestFilters.q %>" placeholder="Search names, emails, or request text"><select class="form-select" name="requestStatus"><option value="">All statuses</option><% prayerRequestStatuses.forEach((status) => { %><option value="<%= status %>" <%= requestFilters.status === status ? 'selected' : '' %>><%= status.replace(/_/g, ' ').replace(/w/g, (char) => char.toUpperCase()) %></option><% }) %></select><select class="form-select" name="isPublic"><option value="">All visibility</option><option value="public" <%= requestFilters.isPublic === 'public' ? 'selected' : '' %>>Public shareable</option><option value="private" <%= requestFilters.isPublic === 'private' ? 'selected' : '' %>>Private only</option></select><button type="submit" class="btn btn-outline-dark rounded-pill">Filter</button></form><div class="table-responsive mt-4"><table class="table align-middle dashboard-table mb-0"><thead><tr><th>Request</th><th>Visibility</th><th>Status</th><th>Received</th><th>Actions</th></tr></thead><tbody><% if (prayerRequests.length) { %><% prayerRequests.forEach((item) => { %><tr><td><strong><%= item.name || 'Anonymous' %></strong><div class="small text-muted"><%= item.requestPreview %></div></td><td><%= item.is_public ? 'Public shareable' : 'Private' %></td><td><span class="badge <%= item.status === 'new' ? 'text-bg-warning-subtle text-dark' : 'text-bg-light text-dark' %>"><%= item.statusLabel %></span></td><td><%= item.createdDisplay %></td><td><div class="table-actions"><form method="post" action="/admin/prayer/requests/<%= item.id %>/status" class="d-inline"><input type="hidden" name="status" value="reviewed"><button type="submit" class="btn btn-outline-dark btn-sm rounded-pill">Reviewed</button></form><form method="post" action="/admin/prayer/requests/<%= item.id %>/status" class="d-inline"><input type="hidden" name="status" value="prayed"><button type="submit" class="btn btn-outline-dark btn-sm rounded-pill">Prayed</button></form><form method="post" action="/admin/prayer/requests/<%= item.id %>/archive" class="d-inline"><button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill">Archive</button></form></div></td></tr><% }) %><% } else { %><tr><td colspan="5"><div class="admin-empty-state"><div class="empty-state-icon"><i class="bi bi-chat-heart"></i></div><h3 class="h5 mb-2">No prayer requests match this view</h3><p class="text-muted mb-0">Prayer requests from the contact page will appear here for staff follow-up.</p></div></td></tr><% } %></tbody></table></div><%- include('../partials/pagination', { pagination: requestPagination, filters: { requestQ: requestFilters.q, requestStatus: requestFilters.status, isPublic: requestFilters.isPublic, partnerQ: partnerFilters.q, partnerStatus: partnerFilters.status, prayerFocus: partnerFilters.prayerFocus, partnerPage: partnerPagination.page, partnerLimit: partnerPagination.limit } }) %></div></div></div></section>

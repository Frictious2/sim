<section class="dashboard-section admin-dashboard-section"><div class="content-card admin-panel-card"><div class="admin-toolbar"><div><h2 class="admin-panel-title mb-1">Volunteer applications</h2><p class="text-muted mb-0">Review volunteer interest submissions, move them through review stages, and keep short staff notes with each application.</p></div></div><form class="admin-filter-bar mt-4" method="get" action="/admin/volunteers"><input class="form-control" type="search" name="q" value="<%= filters.q %>" placeholder="Search applicant names, emails, locations, or motivation"><select class="form-select" name="status"><option value="">All statuses</option><% volunteerStatuses.forEach((status) => { %><option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= status.replace(/_/g, ' ').replace(/w/g, (char) => char.toUpperCase()) %></option><% }) %></select><select class="form-select" name="areaOfInterest"><option value="">All areas</option><% volunteerAreas.forEach((area) => { %><option value="<%= area %>" <%= filters.areaOfInterest === area ? 'selected' : '' %>><%= area.replace(/_/g, ' ').replace(/w/g, (char) => char.toUpperCase()) %></option><% }) %></select><button type="submit" class="btn btn-outline-dark rounded-pill">Filter</button><a href="/admin/volunteers" class="btn btn-outline-secondary rounded-pill">Reset</a></form><div class="admin-list-summary mt-3">Showing <strong><%= pagination.from %>-<%= pagination.to %></strong> of <strong><%= pagination.total %></strong> volunteer applications</div><div class="table-responsive mt-3"><table class="table align-middle dashboard-table mb-0"><thead><tr><th>Name</th><th>Area</th><th>Availability</th><th>Status</th><th>Submitted</th><th>Actions</th></tr></thead><tbody><% if (volunteers.length) { %><% volunteers.forEach((item) => { %><tr><td><strong><%= item.full_name %></strong><div class="small text-muted"><%= item.email %></div></td><td><%= item.areaLabel %></td><td><%= item.availability || 'Flexible / not shared' %></td><td><span class="badge <%= item.statusBadgeClass %>"><%= item.statusLabel %></span></td><td><%= item.createdDisplay %></td><td><div class="table-actions"><a href="/admin/volunteers/<%= item.id %>" class="btn btn-outline-dark btn-sm rounded-pill">View</a><% if (item.status !== 'reviewing') { %><form action="/admin/volunteers/<%= item.id %>/reviewing" method="post" class="d-inline"><button type="submit" class="btn btn-outline-dark btn-sm rounded-pill">Review</button></form><% } %><% if (item.status !== 'approved') { %><form action="/admin/volunteers/<%= item.id %>/approve" method="post" class="d-inline"><button type="submit" class="btn btn-outline-dark btn-sm rounded-pill">Approve</button></form><% } %></div></td></tr><% }) %><% } else { %><tr><td colspan="6"><div class="admin-empty-state"><div class="empty-state-icon"><i class="bi bi-person-lines-fill"></i></div><h3 class="h5 mb-2">No volunteer applications match this view</h3><p class="text-muted mb-0">New applications from the Get Involved page will appear here as soon as visitors submit them.</p></div></td></tr><% } %></tbody></table></div><%- include('../partials/pagination', { pagination, filters }) %></div></section>

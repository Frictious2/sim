<section class="dashboard-section admin-dashboard-section">
  <div class="content-card admin-panel-card">
    <div class="admin-panel-head">
      <div>
        <h2 class="admin-panel-title mb-1">Sponsorship projects</h2>
        <p class="text-muted mb-0">Manage ministry projects and sponsor-facing updates for programs that supporters can underwrite.</p>
      </div>
      <a href="/admin/sponsorship-projects/create" class="btn btn-sunrise rounded-pill">Create Sponsorship Project</a>
    </div>

    <form class="admin-filter-bar mt-4" method="get" action="/admin/sponsorship-projects">
      <input class="form-control" type="search" name="q" value="<%= filters.q %>" placeholder="Search title, summary, description, or slug">
      <select class="form-select" name="status"><option value="">All statuses</option><% projectStatuses.forEach((status) => { %><option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= status.replace(/_/g, ' ') %></option><% }) %></select>
      <select class="form-select" name="category"><option value="">All categories</option><% projectCategories.forEach((category) => { %><option value="<%= category %>" <%= filters.category === category ? 'selected' : '' %>><%= category %></option><% }) %></select>
      <button type="submit" class="btn btn-outline-dark rounded-pill">Filter</button>
      <a href="/admin/sponsorship-projects" class="btn btn-outline-secondary rounded-pill">Reset</a>
    </form>

    <% if (projects.length) { %>
      <div class="table-responsive mt-3"><table class="table admin-table align-middle mb-0"><thead><tr><th>Project</th><th>Category</th><th>Status</th><th>Target</th><th>Updated</th><th class="text-end">Actions</th></tr></thead><tbody><% projects.forEach((item) => { %><tr><td><div class="fw-semibold"><%= item.title %></div><small class="text-muted d-block"><%= item.summary %></small></td><td><%= item.category %></td><td><span class="badge <%= item.statusBadgeClass %>"><%= item.statusLabel %></span></td><td><%= item.target_amount ? `NLe ${item.target_amount}` : 'Not set' %></td><td><%= item.createdDisplay %></td><td class="text-end"><div class="d-flex justify-content-end gap-2 flex-wrap"><a href="/admin/sponsorship-projects/<%= item.id %>/edit" class="btn btn-outline-dark btn-sm rounded-pill">Edit</a><form method="post" action="/admin/sponsorship-projects/<%= item.id %>/archive" class="d-inline"><button type="submit" class="btn btn-outline-danger btn-sm rounded-pill">Archive</button></form></div></td></tr><% }) %></tbody></table></div>
    <% } else { %>
      <div class="admin-empty-state mt-3"><div class="empty-state-icon"><i class="bi bi-diagram-3"></i></div><h3 class="h5 mb-2">No sponsorship projects yet</h3><p class="text-muted mb-3">Create your first program or project sponsorship opportunity here.</p><a href="/admin/sponsorship-projects/create" class="btn btn-sunrise rounded-pill">Create Project</a></div>
    <% } %>

    <%- include('../partials/pagination', { pagination, filters }) %>
  </div>
</section>

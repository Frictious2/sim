<section class="dashboard-section admin-dashboard-section">
  <div class="content-card admin-panel-card admin-form-card">
    <div class="admin-panel-head">
      <div>
        <h2 class="admin-panel-title mb-1"><%= formTitle %></h2>
        <p class="text-muted mb-0">Edit structured homepage content while keeping the premium homepage layout intact.</p>
      </div>
      <a href="/admin/homepage-content" class="btn btn-outline-dark rounded-pill btn-sm">Back to Homepage Content</a>
    </div>

    <form action="<%= formAction %>" method="post" class="row g-4 mt-1">
      <div class="col-lg-6">
        <label class="form-label fw-semibold">Section key <span class="text-danger">*</span></label>
        <input class="form-control" name="sectionKey" value="<%= sectionItem.section_key %>" required>
      </div>
      <div class="col-lg-3">
        <label class="form-label fw-semibold">Sort order</label>
        <input class="form-control" type="number" name="sortOrder" value="<%= sectionItem.sort_order %>">
      </div>
      <div class="col-lg-3">
        <div class="form-check mt-lg-5 pt-lg-2">
          <input class="form-check-input" type="checkbox" name="isActive" id="isActive" <%= sectionItem.is_active ? 'checked' : '' %>>
          <label class="form-check-label" for="isActive">Section is active</label>
        </div>
      </div>
      <div class="col-lg-6">
        <label class="form-label fw-semibold">Title</label>
        <input class="form-control" name="title" value="<%= sectionItem.title || '' %>">
      </div>
      <div class="col-lg-6">
        <label class="form-label fw-semibold">Subtitle</label>
        <input class="form-control" name="subtitle" value="<%= sectionItem.subtitle || '' %>">
      </div>
      <div class="col-lg-6">
        <label class="form-label fw-semibold">Button label</label>
        <input class="form-control" name="buttonLabel" value="<%= sectionItem.button_label || '' %>">
      </div>
      <div class="col-lg-6">
        <label class="form-label fw-semibold">Button URL</label>
        <input class="form-control" name="buttonUrl" value="<%= sectionItem.button_url || '' %>">
      </div>
      <div class="col-12">
        <label class="form-label fw-semibold">Image URL</label>
        <input class="form-control" data-image-preview-input="homepage-section-image" name="imageUrl" value="<%= sectionItem.image_url || '' %>">
        <div class="form-text">Upload images in Media Library, then paste the media URL here.</div>
      </div>
      <div class="col-12">
        <div class="admin-image-preview-card" data-image-preview-target="homepage-section-image">
          <div class="admin-image-preview-empty">Image preview will appear here.</div>
        </div>
      </div>
      <div class="col-12">
        <label class="form-label fw-semibold">Content</label>
        <textarea class="form-control" name="content" rows="14"><%= sectionItem.content || '' %></textarea>
        <div class="form-text">Use rich text-style prose for simple sections, or preserve JSON for structured sections such as hero stats or impact band data.</div>
      </div>
      <div class="col-12 d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-sunrise rounded-pill px-4">Save Section</button>
        <a href="/admin/homepage-content" class="btn btn-outline-dark rounded-pill px-4">Cancel</a>
      </div>
    </form>
  </div>
</section>

<section class="dashboard-section"><div class="content-card"><h2 class="h4">Messages</h2><div class="table-responsive mt-3"><table class="table align-middle"><thead><tr><th>Name</th><th>Subject</th><th>Date</th><th>Status</th></tr></thead><tbody><% content.adminMessages.forEach((item) => { %><tr><td><%= item.name %></td><td><%= item.subject %></td><td><%= item.date %></td><td><span class="badge text-bg-warning-subtle text-dark"><%= item.status %></span></td></tr><% }) %></tbody></table></div></div></section>

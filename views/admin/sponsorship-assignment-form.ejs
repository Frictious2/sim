<section class="dashboard-section admin-dashboard-section">
  <div class="content-card admin-panel-card admin-form-card">
    <div class="admin-panel-head">
      <div>
        <h2 class="admin-panel-title mb-1"><%= formTitle %></h2>
        <p class="text-muted mb-0">Assignments work best when they are linked to a registered sponsor user and, where possible, an earlier sponsorship interest.</p>
      </div>
      <a href="/admin/sponsorship-assignments" class="btn btn-outline-dark rounded-pill btn-sm">Back to Assignments</a>
    </div>

    <form action="<%= formAction %>" method="post" class="row g-4 mt-1">
      <div class="col-md-4"><label class="form-label fw-semibold">Sponsor user ID <span class="text-danger">*</span></label><input class="form-control" name="sponsorUserId" value="<%= assignment ? assignment.sponsor_user_id : '' %>" required><div class="form-text">Use the registered user ID for the sponsor account.</div></div>
      <div class="col-md-4"><label class="form-label fw-semibold">Linked sponsorship interest</label><select class="form-select" name="sponsorshipInterestId"><option value="">None</option><% interestOptions.forEach((item) => { %><option value="<%= item.id %>" <%= assignment && Number(assignment.sponsorship_interest_id || 0) === Number(item.id) ? 'selected' : '' %>><%= item.id %> • <%= item.sponsor_name %> • <%= item.sponsorship_type %></option><% }) %></select></div>
      <div class="col-md-4"><label class="form-label fw-semibold">Status</label><select class="form-select" name="status"><% assignmentStatuses.forEach((status) => { %><option value="<%= status %>" <%= assignment && assignment.status === status ? 'selected' : '' %>><%= status.replace(/_/g, ' ') %></option><% }) %></select></div>
      <div class="col-md-4"><label class="form-label fw-semibold">Assignment type</label><select class="form-select" name="assignmentType"><% assignmentTypes.forEach((type) => { %><option value="<%= type %>" <%= assignment && assignment.assignment_type === type ? 'selected' : '' %>><%= type.replace(/_/g, ' ') %></option><% }) %></select></div>
      <div class="col-md-4"><label class="form-label fw-semibold">Child profile</label><select class="form-select" name="childId"><option value="">Select child</option><% childOptions.forEach((item) => { %><option value="<%= item.id %>" <%= assignment && Number(assignment.child_id || 0) === Number(item.id) ? 'selected' : '' %>><%= item.child_code %> • <%= item.first_name %> <%= item.last_name || '' %></option><% }) %></select></div>
      <div class="col-md-4"><label class="form-label fw-semibold">Sponsorship project</label><select class="form-select" name="projectId"><option value="">Select project</option><% projectOptions.forEach((item) => { %><option value="<%= item.id %>" <%= assignment && Number(assignment.project_id || 0) === Number(item.id) ? 'selected' : '' %>><%= item.title %></option><% }) %></select></div>
      <div class="col-md-6"><label class="form-label fw-semibold">Mission worker</label><select class="form-select" name="missionWorkerId"><option value="">Select worker</option><% workerOptions.forEach((item) => { %><option value="<%= item.id %>" <%= assignment && Number(assignment.mission_worker_id || 0) === Number(item.id) ? 'selected' : '' %>><%= item.worker_code %> • <%= item.first_name %> <%= item.last_name %></option><% }) %></select></div>
      <div class="col-12"><label class="form-label fw-semibold">Notes</label><textarea class="form-control" name="notes" rows="5"><%= assignment ? assignment.notes : '' %></textarea></div>
      <div class="col-12 d-flex flex-wrap gap-2"><button type="submit" class="btn btn-sunrise rounded-pill px-4">Save Assignment</button><a href="/admin/sponsorship-assignments" class="btn btn-outline-dark rounded-pill px-4">Cancel</a></div>
    </form>
  </div>
</section>

<section class="dashboard-section admin-dashboard-section">
  <div class="content-card admin-panel-card">
    <div class="admin-panel-head">
      <div>
        <h2 class="admin-panel-title mb-1">Editable pages</h2>
        <p class="text-muted mb-0">Manage core website page text and SEO details while preserving the designed layouts.</p>
      </div>
      <a href="/admin/pages/create" class="btn btn-sunrise rounded-pill">Create Page</a>
    </div>

    <form class="admin-filter-bar mt-4" method="get" action="/admin/pages">
      <input class="form-control" type="search" name="q" value="<%= filters.q %>" placeholder="Search page titles, slugs, subtitles, or content">
      <select class="form-select" name="status">
        <option value="">All statuses</option>
        <% ['draft', 'published'].forEach((status) => { %>
          <option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= status.charAt(0).toUpperCase() + status.slice(1) %></option>
        <% }) %>
      </select>
      <button type="submit" class="btn btn-outline-dark rounded-pill">Filter</button>
      <a href="/admin/pages" class="btn btn-outline-secondary rounded-pill">Reset</a>
    </form>

    <% if (pages.length) { %>
      <div class="table-responsive mt-3">
        <table class="table admin-table align-middle mb-0">
          <thead>
            <tr>
              <th>Title</th>
              <th>Slug</th>
              <th>Status</th>
              <th>Updated</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% pages.forEach((item) => { %>
              <tr>
                <td>
                  <div class="fw-semibold"><%= item.title %></div>
                  <small class="text-muted d-block"><%= item.subtitle || 'No subtitle yet' %></small>
                </td>
                <td><code><%= item.slug %></code></td>
                <td><span class="badge <%= item.statusBadgeClass %>"><%= item.statusLabel %></span></td>
                <td><%= item.updatedDisplay %></td>
                <td class="text-end">
                  <div class="d-flex justify-content-end flex-wrap gap-2">
                    <% if (item.previewHref) { %>
                      <a href="<%= item.previewHref %>" class="btn btn-outline-dark btn-sm rounded-pill" target="_blank" rel="noopener">Preview</a>
                    <% } %>
                    <a href="/admin/pages/<%= item.id %>/edit" class="btn btn-outline-dark btn-sm rounded-pill">Edit</a>
                    <form action="/admin/pages/<%= item.id %>/archive" method="post" class="d-inline">
                      <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill">Move to Draft</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="admin-empty-state mt-3">
        <div class="empty-state-icon"><i class="bi bi-file-earmark-text"></i></div>
        <h3 class="h5 mb-2">No editable pages match this view</h3>
        <p class="text-muted mb-3">Create the first editable page record here. The public layouts will still fall back safely if a page record is missing.</p>
        <a href="/admin/pages/create" class="btn btn-sunrise rounded-pill">Create First Page</a>
      </div>
    <% } %>

    <%- include('../partials/pagination', { pagination, filters }) %>
  </div>
</section>

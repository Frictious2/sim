<section class="dashboard-section"><div class="content-card"><h2 class="h4">Donations</h2><div class="table-responsive mt-3"><table class="table align-middle"><thead><tr><th>Donor</th><th>Campaign</th><th>Amount</th><th>Status</th></tr></thead><tbody><% content.adminDonations.forEach((item) => { %><tr><td><%= item.donor %></td><td><%= item.campaign %></td><td><%= item.amount %></td><td><span class="badge text-bg-light"><%= item.status %></span></td></tr><% }) %></tbody></table></div></div></section>

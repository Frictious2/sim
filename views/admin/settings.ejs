<section class="dashboard-section admin-dashboard-section">
  <div class="row g-4 mb-4">
    <% settingGroups.forEach((groupItem) => { %>
      <div class="col-lg-6">
        <article class="content-card admin-panel-card h-100">
          <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
            <div>
              <div class="small text-uppercase text-muted fw-semibold">Settings group</div>
              <h2 class="h5 mt-2 mb-1"><%= groupItem.group.charAt(0).toUpperCase() + groupItem.group.slice(1) %></h2>
            </div>
            <span class="badge text-bg-success-subtle text-success"><%= groupItem.items.length %> values</span>
          </div>
          <p class="text-muted mb-0">Manage the <%= groupItem.group %> values that now feed the footer, site branding, contact details, and SEO defaults.</p>
        </article>
      </div>
    <% }) %>
  </div>

  <div class="content-card admin-panel-card admin-form-card">
    <div class="admin-panel-head">
      <div>
        <h2 class="admin-panel-title mb-1">Platform settings</h2>
        <p class="text-muted mb-0">Keep this simple for now: grouped key settings for branding, contact details, social links, and default SEO metadata.</p>
      </div>
    </div>

    <% const byKey = {}; %>
    <% settingGroups.forEach((groupItem) => { groupItem.items.forEach((item) => { byKey[item.setting_key] = item.setting_value || ''; }); }); %>

    <form action="/admin/settings" method="post" class="row g-4 mt-1">
      <div class="col-md-6">
        <label class="form-label fw-semibold">Site name <span class="text-danger">*</span></label>
        <input class="form-control" name="site_name" value="<%= byKey.site_name || '' %>">
        <div class="form-text">Used in the site header, footer, and default page title fallback.</div>
      </div>
      <div class="col-md-6">
        <label class="form-label fw-semibold">Contact email</label>
        <input class="form-control" name="contact_email" value="<%= byKey.contact_email || '' %>">
      </div>
      <div class="col-md-6">
        <label class="form-label fw-semibold">Contact phone</label>
        <input class="form-control" name="contact_phone" value="<%= byKey.contact_phone || '' %>">
      </div>
      <div class="col-md-6">
        <label class="form-label fw-semibold">WhatsApp number</label>
        <input class="form-control" name="whatsapp_number" value="<%= byKey.whatsapp_number || '' %>">
      </div>
      <div class="col-12">
        <label class="form-label fw-semibold">Office address</label>
        <input class="form-control" name="office_address" value="<%= byKey.office_address || '' %>">
      </div>
      <div class="col-md-6">
        <label class="form-label fw-semibold">Facebook URL</label>
        <input class="form-control" name="facebook_url" value="<%= byKey.facebook_url || '' %>">
      </div>
      <div class="col-md-6">
        <label class="form-label fw-semibold">YouTube URL</label>
        <input class="form-control" name="youtube_url" value="<%= byKey.youtube_url || '' %>">
      </div>
      <div class="col-md-6">
        <label class="form-label fw-semibold">Default meta title</label>
        <input class="form-control" name="default_meta_title" value="<%= byKey.default_meta_title || '' %>">
      </div>
      <div class="col-md-6">
        <label class="form-label fw-semibold">Default meta description</label>
        <input class="form-control" data-character-count-target="settings-meta-count" name="default_meta_description" value="<%= byKey.default_meta_description || '' %>">
        <div class="d-flex justify-content-between form-text">
          <span>Falls back when no page-specific description is present.</span>
          <span><span data-character-count="settings-meta-count">0</span> characters</span>
        </div>
      </div>
      <div class="col-12 d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-sunrise rounded-pill px-4">Save Settings</button>
        <button type="button" class="btn btn-outline-dark rounded-pill px-4">Donation settings placeholder</button>
        <button type="button" class="btn btn-outline-dark rounded-pill px-4">Email notifications placeholder</button>
      </div>
    </form>
  </div>

  <div class="content-card admin-panel-card admin-form-card mt-4">
    <div class="admin-panel-head">
      <div>
        <h2 class="admin-panel-title mb-1">Communication test</h2>
        <p class="text-muted mb-0">Use this to confirm SMTP behavior. If <code>MAIL_ENABLED=false</code>, the action will be skipped safely and still logged.</p>
      </div>
    </div>

    <form action="/admin/settings/test-email" method="post" class="row g-3 mt-1">
      <div class="col-md-8">
        <label class="form-label fw-semibold">Test email address</label>
        <input class="form-control" name="test_email" placeholder="Leave blank to use ADMIN_NOTIFICATION_EMAIL">
      </div>
      <div class="col-md-4 d-flex align-items-end">
        <button type="submit" class="btn btn-outline-dark rounded-pill w-100">Send Test Email</button>
      </div>
      <div class="col-12">
        <div class="form-text">If a direct address is not entered, the system will try <code>ADMIN_NOTIFICATION_EMAIL</code> from your environment configuration.</div>
      </div>
    </form>
  </div>
</section>

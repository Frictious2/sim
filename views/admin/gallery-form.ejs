<section class="dashboard-section admin-dashboard-section">
  <div class="content-card admin-panel-card admin-form-card">
    <div class="admin-panel-head">
      <div>
        <h2 class="admin-panel-title mb-1"><%= formTitle %></h2>
        <p class="text-muted mb-0">Upload images in the Media Library, then paste the media URL here for gallery publishing.</p>
      </div>
      <a href="/admin/gallery" class="btn btn-outline-dark rounded-pill btn-sm">Back to Gallery</a>
    </div>

    <form action="<%= formAction %>" method="post" class="row g-4 mt-1">
      <div class="col-lg-8">
        <label class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
        <input class="form-control" name="title" value="<%= galleryItem ? galleryItem.title : '' %>" required>
      </div>
      <div class="col-lg-4">
        <label class="form-label fw-semibold">Sort order</label>
        <input class="form-control" type="number" name="sortOrder" value="<%= galleryItem ? galleryItem.sort_order : 0 %>">
      </div>
      <div class="col-md-6">
        <label class="form-label fw-semibold">Category</label>
        <input class="form-control" name="category" value="<%= galleryItem ? (galleryItem.category || '') : '' %>">
      </div>
      <div class="col-md-6">
        <label class="form-label fw-semibold">Status <span class="text-danger">*</span></label>
        <select class="form-select" name="status">
          <% ['draft', 'published', 'archived'].forEach((status) => { %>
            <option value="<%= status %>" <%= galleryItem && galleryItem.status === status ? 'selected' : (!galleryItem && status === 'draft' ? 'selected' : '') %>><%= status.charAt(0).toUpperCase() + status.slice(1) %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-12">
        <label class="form-label fw-semibold">Image URL <span class="text-danger">*</span></label>
        <input class="form-control" data-image-preview-input="gallery-image" name="imageUrl" value="<%= galleryItem ? galleryItem.image_url : '' %>" placeholder="/uploads/media/example.webp" required>
        <div class="form-text">Upload images in Media Library, then paste the media URL here.</div>
      </div>
      <div class="col-12">
        <div class="admin-image-preview-card" data-image-preview-target="gallery-image">
          <div class="admin-image-preview-empty">Image preview will appear here.</div>
        </div>
      </div>
      <div class="col-12">
        <label class="form-label fw-semibold">Caption</label>
        <textarea class="form-control" data-character-count-target="gallery-caption-count" name="caption" rows="4"><%= galleryItem ? (galleryItem.caption || '') : '' %></textarea>
        <div class="d-flex justify-content-between form-text">
          <span>Short supporting copy for gallery previews and context.</span>
          <span><span data-character-count="gallery-caption-count">0</span> characters</span>
        </div>
      </div>
      <div class="col-12 d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-sunrise rounded-pill px-4">Save Gallery Item</button>
        <a href="/admin/gallery" class="btn btn-outline-dark rounded-pill px-4">Cancel</a>
      </div>
    </form>
  </div>
</section>
